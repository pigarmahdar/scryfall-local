# ── Price display ─────────────────────────────────────────────────────
def format_price(value, symbol="$"):
    """Format a price string with currency symbol, or return '—' for None/null."""
    if value is None:
        return "—"
    try:
        amount = float(value)
        return f"{symbol}{amount:,.2f}"
    except (ValueError, TypeError):
        return "—"

def display_price_card(card, index=None):
    """Display a card with prices prominent."""
    name = card.get("name", "Unknown")
    mana = card.get("mana_cost", "—")
    type_line = card.get("type_line", "—")
    cmc = card.get("cmc", "?")
    cmc_display = int(cmc) if isinstance(cmc, (int, float)) and cmc == int(cmc) else cmc
    colors = card.get("color_identity", [])
    prices = card.get("prices", {})

    colour_str = " ".join(COLOUR_SYMBOLS.get(c, c) for c in colors) if colors else "—"

    usd = format_price(prices.get("usd"), "$")
    usd_foil = format_price(prices.get("usd_foil"), "$")
    eur = format_price(prices.get("eur"), "€")
    eur_foil = format_price(prices.get("eur_foil"), "€")
    tix = format_price(prices.get("tix"), "")

    prefix = f"  [{index}] " if index is not None else "  "
    print(f"\n{prefix}\033[1;33m{name}\033[0m  {mana}  (CMC {cmc_display})")
    print(f"       {type_line}  •  {colour_str}")

    # Price line — only show foil if it has a value
    usd_part = f"USD {usd}"
    if usd_foil != "—":
        usd_part += f" (foil {usd_foil})"
    eur_part = f"EUR {eur}"
    if eur_foil != "—":
        eur_part += f" (foil {eur_foil})"
    tix_part = f"TIX {tix}"

    print(f"       \033[1;32m{usd_part}\033[0m  •  {eur_part}  •  {tix_part}")
    print(f"       {card.get('scryfall_uri', '')}")

# ── Image download ──────────────────────────────────────────────────────
def _safe_filename(name):
    """Turn a card name into a safe filename (keep spaces, strip path chars)."""
    cleaned = re.sub(r'[<>:"/\\|?*\x00-\x1f]', "", name)
    return cleaned.strip() or "card"

def _pick_image(card, size="png", border=None):
    """Pick an image URI from a card dict. Returns (uri, ext) or (None, None)."""
    uris = card.get("image_uris") or {}
    # Some special cards (tokens, double-faced backs) store per-face URIs in
    # `card_faces`. Fall back to the first face that has images.
    if not uris and card.get("card_faces"):
        for face in card["card_faces"]:
            if face.get("image_uris"):
                uris = face["image_uris"]
                break

    if not uris:
        return None, None

    # Order of preference by requested size
    order = {
        "small": ["small", "normal", "large", "png"],
        "normal": ["normal", "large", "png", "small"],
        "large": ["large", "png", "normal", "small"],
        "png": ["png", "large", "normal", "small"],
    }.get(size, ["png", "large", "normal", "small"])

    uri = next((uris[k] for k in order if uris.get(k)), None)
    if not uri:
        return None, None

    # Determine extension from the URL itself (e.g. .png vs .jpg)
    path = urllib.parse.urlparse(uri).path.lower()
    ext = ".png" if path.endswith(".png") else (".jpg" if path.endswith(".jpg") else ".bin")
    return uri, ext

def _similarity(query, name):
    """Similarity score of query vs card name (0..1), with word-start bonus."""
    q, n = query.lower(), name.lower()
    ratio = difflib.SequenceMatcher(None, q, n).ratio()
    # Bonus if every query word lines up with a word in the name
    q_words = [w for w in re.split(r'\s+', q) if w]
    n_words = re.split(r'\s+', n)
    if q_words and all(any(nw.startswith(qw) or qw.startswith(nw) for nw in n_words) for qw in q_words):
        return max(ratio, 0.95)
    # Typo-tolerant: most query words found inside the name (e.g. "sol rng" → Sol Ring)
    contained = sum(1 for qw in q_words if len(qw) >= 2 and qw in n)
    if q_words and contained / len(q_words) >= 0.75:
        return max(ratio, 0.85)
    return ratio

def _normalize_name(name):
    """Lowercase, drop punctuation — used for closest-match comparison."""
    return re.sub(r"[’'\".,!?|()/\\:-]", "", name.lower()).strip()

def _api_closest_match(card, query):
    """If the API returned an ambiguous result, pick the closest 'name' from its list."""
    candidates = card.get("name")
    if not isinstance(candidates, list) or not candidates:
        return None
    q_norm = _normalize_name(query)
    best = max(candidates, key=lambda c: _similarity(q_norm, _normalize_name(c)))
    return best if _similarity(q_norm, _normalize_name(best)) >= 0.6 else None

def handle_image(query, options):
    """Resolve a card name and download its image."""
    query = query.strip().strip('"')
    if not query:
        print("\n  Usage: scryfall image <card name> [--size small|normal|large|png] [--out <dir>] [--border black|silver]\n")
        return

    size = options.get("size", "png")
    out_dir = os.path.expanduser(options.get("out") or "~/Desktop")
    border = options.get("border")

    # Step 1: Scryfall fuzzy lookup (handles typos + gives us image URLs)
    api_card = scryfall_fuzzy(query)
    if api_card and api_card.get("error"):
        api_card = None
    if api_card and isinstance(api_card.get("name"), list):
        # Ambiguous match — API returned several candidate names; pick the best one
        chosen = _api_closest_match(api_card, query)
        api_card = scryfall_fuzzy(chosen) if chosen else None
        if api_card and api_card.get("error"):
            api_card = None
    # Guard against unrelated printed-name coincidences (e.g. fuzzy "sol rng"
    # returning a Portuguese card whose printed name starts with "Sol R")
    if api_card and not isinstance(api_card.get("name"), list):
        if _similarity(query, api_card.get("name", "")) < 0.55:
            api_card = None

    # Step 2: Local cache candidates (exact match wins outright)
    local_exact = search_name(query, exact=True)
    local_partial = [] if local_exact else search_name(query)

    # Step 3: Typo tolerance — match each query word against cached card names
    local_typo = []
    if not local_exact and not local_partial and len(query.split()) >= 2:
        q_words = [w.lower() for w in re.split(r'\s+', query) if len(w) >= 2]
        for card in CARDS:
            n_words = re.split(r'\s+', card.get("name", "").lower())
            hits = sum(1 for qw in q_words
                       if any(difflib.SequenceMatcher(None, qw, nw).ratio() >= 0.6 for nw in n_words))
            if hits == len(q_words):
                local_typo.append(card)

    card = None
    sim = 0.0
    if local_exact:
        card = local_exact[0]
        sim = 1.0
    elif api_card and not isinstance(api_card.get("name"), list):
        sim = _similarity(query, api_card.get("name", ""))
        card = api_card
    elif local_typo:
        best = max(local_typo, key=lambda c: _similarity(query, c.get("name", "")))
        card = best
        sim = _similarity(query, best.get("name", ""))

    # Step 3: Fall back to the best partial match from the local cache
    if card is None and local_partial:
        best = max(local_partial, key=lambda c: _similarity(query, c.get("name", "")))
        card = best
        sim = _similarity(query, best.get("name", ""))

    if card is None:
        print(f"\n  \033[1;31m✗ Could not find a card matching \"{query}\".\033[0m\n")
        return

    name = card.get("name", "Unknown")
    note = "" if sim >= 0.9 else f"  \033[2m(from \"{query}\")\033[0m"
    print(f"\n  \033[1mCard:\033[0m {name}{note}")

    # If a border is requested, ask the API for that specific version
    if border:
        set_code = (card.get("set") or "").upper()
        api_card = _api_get("/cards/named", {"exact": name, "set": set_code}) if set_code else None
        if api_card and not api_card.get("error") and api_card.get("border") == border:
            card = api_card
        else:
            print(f"  \033[1;33m⚠ No {border}-border version found; using default.\033[0m")

    uri, ext = _pick_image(card, size=size)
    if not uri:
        print(f"  \033[1;31m✗ No image available for this card.\033[0m\n")
        return

    # Build output path — avoid clobbering existing files
    os.makedirs(out_dir, exist_ok=True)
    base = _safe_filename(name)
    out_path = os.path.join(out_dir, f"{base}{ext}")
    counter = 1
    while os.path.exists(out_path):
        out_path = os.path.join(out_dir, f"{base} ({counter}){ext}")
        counter += 1

    print(f"  \033[2mSource:\033[0m {uri}")
    try:
        req = urllib.request.Request(uri, headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=60) as resp, open(out_path, "wb") as f:
            shutil.copyfileobj(resp, f)
    except Exception as e:
        print(f"  \033[1;31m✗ Download failed: {e}\033[0m\n")
        return

    size_kb = os.path.getsize(out_path) / 1024
    print(f"  \033[1;32m✓ Saved:\033[0m {out_path}  (\033[2m{size_kb:.0f} KB\033[0m)\n")

# ── Apply filters ───────────────────────────────────────────────────────
def apply_filters(results, commander=None, legal=None):
    if commander:
        allowed = set(commander.upper())
        results = [c for c in results if set(c.get("color_identity", [])).issubset(allowed)]
    if legal:
        legal = legal.lower()
        results = [c for c in results if c.get("legalities", {}).get(legal) == "legal"]
    return results

# ── Parse arguments ─────────────────────────────────────────────────────
def parse_args(args):
    """Parse command line arguments into (command, query, options)."""
    command = None
    query_parts = []
    options = {"limit": 10, "commander": None, "legal": None, "exact": False, "sort": None,
               "size": None, "out": None, "border": None}

    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--limit" and i + 1 < len(args):
            try:
                options["limit"] = int(args[i + 1])
            except ValueError:
                pass
            i += 2
        elif arg == "--commander" and i + 1 < len(args):
            options["commander"] = args[i + 1]
            i += 2
        elif arg == "--legal" and i + 1 < len(args):
            options["legal"] = args[i + 1]
            i += 2
        elif arg == "--exact":
            options["exact"] = True
            i += 1
        elif arg == "--sort" and i + 1 < len(args):
            options["sort"] = args[i + 1].lower()
            i += 2
        elif arg == "--size" and i + 1 < len(args):
            options["size"] = args[i + 1].lower()
            i += 2
        elif arg == "--out" and i + 1 < len(args):
            options["out"] = args[i + 1]
            i += 2
        elif arg == "--border" and i + 1 < len(args):
            options["border"] = args[i + 1].lower()
            i += 2
        elif command is None:
            command = arg.lower()
            i += 1
        else:
            query_parts.append(arg)
            i += 1

    query = " ".join(query_parts) if query_parts else ""
    return command, query, options

# ── Update cache ─────────────────────────────────────────────────────
def handle_update():
    """Download the latest Oracle Cards bulk data from Scryfall."""
    cache_dir = os.path.dirname(ORACLE_PATH)
    os.makedirs(cache_dir, exist_ok=True)

    gz_path = ORACLE_PATH + ".gz"
    backup_path = ORACLE_PATH + ".backup"

    # 1. Get the download URL
    print("\n  Fetching Scryfall bulk-data catalogue...")
    try:
        req = urllib.request.Request(
            "https://api.scryfall.com/bulk-data",
            headers={"User-Agent": "scryfall-cli/1.0", "Accept": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            bulk_data = json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(f"\033[1;31m  ✗ Failed to fetch catalogue: {e}\033[0m")
        sys.exit(1)

    download_url = None
    for item in bulk_data.get("data", []):
        if item.get("type") == "oracle_cards":
            download_url = item.get("jsonl_download_uri")
            break

    if not download_url:
        print("\033[1;31m  ✗ Could not find oracle_cards download URL.\033[0m")
        sys.exit(1)

    # 2. Download the gzipped file
    print(f"  Downloading from:\n  {download_url}")
    try:
        req = urllib.request.Request(
            download_url,
            headers={"User-Agent": "scryfall-cli/1.0"},
        )
        with urllib.request.urlopen(req, timeout=300) as resp:
            with open(gz_path, "wb") as f:
                shutil.copyfileobj(resp, f)
    except Exception as e:
        print(f"\033[1;31m  ✗ Download failed: {e}\033[0m")
        sys.exit(1)

    if os.path.getsize(gz_path) == 0:
        os.remove(gz_path)
        print("\033[1;31m  ✗ Downloaded file is empty.\033[0m")
        sys.exit(1)

    # 3. Decompress and replace
    print("  Decompressing...")
    try:
        # Back up existing cache
        if os.path.exists(ORACLE_PATH):
            shutil.copy2(ORACLE_PATH, backup_path)

        with gzip.open(gz_path, "rb") as f_in:
            with open(ORACLE_PATH, "wb") as f_out:
                shutil.copyfileobj(f_in, f_out)

        os.remove(gz_path)
    except Exception as e:
        # Restore backup on failure
        if os.path.exists(backup_path):
            shutil.move(backup_path, ORACLE_PATH)
        if os.path.exists(gz_path):
            os.remove(gz_path)
        print(f"\033[1;31m  ✗ Decompression failed: {e}\033[0m")
        sys.exit(1)

    # 4. Count and report
    line_count = 0
    with open(ORACLE_PATH, "r", encoding="utf-8") as f:
        for line in f:
            if line.strip():
                line_count += 1

    file_size = os.path.getsize(ORACLE_PATH)
    size_mb = file_size / (1024 * 1024)
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")

    # Clean up backup
    if os.path.exists(backup_path):
        os.remove(backup_path)

    print(f"\n  \033[1;32m✓ Oracle cache updated: {timestamp}\033[0m")
    print(f"    File:  {ORACLE_PATH}")
    print(f"    Size:  {size_mb:.1f} MB")
    print(f"    Cards: {line_count:,}\n")

VALID_COMMANDS = {"name", "text", "type", "color", "cmc", "keyword", "fuzzy", "random", "search", "price", "image", "update"}

def sort_results(results, sort_key):
    """Sort results by the given key."""
    if sort_key == "name":
        return sorted(results, key=lambda c: c.get("name", "").lower())
    elif sort_key == "cmc":
        return sorted(results, key=lambda c: c.get("cmc", 0))
    elif sort_key == "price":
        def usd_val(c):
            p = c.get("prices", {}).get("usd")
            return float(p) if p else 0
        return sorted(results, key=usd_val, reverse=True)
    else:
        print(f"\n  \033[1;33m⚠ Unknown sort field '{sort_key}'. Use 'name', 'cmc', or 'price'.\033[0m")
        return results

# ── Main ────────────────────────────────────────────────────────────────
def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return

    command, query, options = parse_args(sys.argv[1:])

    # Handle update command (doesn't need card data)
    if command == "update":
        handle_update()
        return

    # Handle image command (uses API first, local cache as fallback)
    if command == "image":
        load_cards()
        handle_image(query, options)
        return

    # Validate command (#4)
    if command and command not in VALID_COMMANDS:
        print(f"\n  \033[1;31m✗ Unknown command '{command}'.\033[0m")
        print(f"  Valid commands: {', '.join(sorted(VALID_COMMANDS - {'update'}))}")
        print(f"  Use 'scryfall search \"{command} {query}\"' for a general search.\n")
        sys.exit(1)

    # Guard empty queries (#1) — except random which needs no query
    if command != "random" and not query.strip():
        print(f"\n  \033[1;31m✗ No search query provided.\033[0m")
        print(f"  Usage: scryfall {command} <query>\n")
        sys.exit(1)

    # Load cards
    load_cards()

    # Run search
    results = []
    if command == "name":
        results = search_name(query, exact=options["exact"])
    elif command == "fuzzy":
        handle_fuzzy(query)
        return
    elif command == "text":
        results = search_text(query)
    elif command == "type":
        results = search_type(query)
    elif command == "color":
        results = search_color(query)
    elif command == "cmc":
        results = search_cmc(query)
    elif command == "keyword":
        results = search_keyword(query)
    elif command == "random":
        results = search_random()
    elif command == "search":
        results = search_general(query)
    elif command == "price":
        results = search_name(query, exact=options["exact"])
        # Default to price-sorted (most expensive first) when no sort specified
        if not options["sort"]:
            options["sort"] = "price"

    # Apply filters
    results = apply_filters(results, commander=options["commander"], legal=options["legal"])

    # Apply sort (#5)
    if options["sort"]:
        results = sort_results(results, options["sort"])

    # Display
    if not results:
        print(f"\n  No cards found matching your search.")
        return

    limit = options["limit"]
    total = len(results)
    shown = min(limit, total)

    if total > shown:
        print(f"\n  Showing {shown} of {total} results (use --limit {total} to see all):")
    else:
        print(f"\n  Found {total} result{'s' if total != 1 else ''}:")

    display_fn = display_price_card if command == "price" else display_card
    for i, card in enumerate(results[:shown], 1):
        display_fn(card, index=i)

    print()  # trailing newline

if __name__ == "__main__":
    main()
