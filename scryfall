#!/usr/bin/env python3
"""
scryfall — Local MTG card search from your Oracle cache.
Usage:
  scryfall <command> <query> [options]

Commands:
  name <query>        Search by card name (partial match)
  text <query>        Search by oracle text (what the card does)
  type <query>        Search by type line (creature, enchantment, etc.)
  color <W|U|B|R|G>  Search by colour identity (combine letters, e.g. WG)
  cmc <number>        Search by mana value (exact or <=  / >=)
  keyword <query>     Search by keyword (Flying, Trample, etc.)
  fuzzy <query>        Fuzzy name search (handles typos, partial names)
  random              Get a random card
  search <query>      General search across name + text + type
  price <query>       Search by name, showing market prices
  image <name>        Download PNG image of a card (to Desktop by default)
  update              Update the Oracle cache from Scryfall

Options:
  --limit N           Max results (default: 10)
  --commander <WUBRG> Cards whose colour identity fits within these colours
  --legal <format>    Only cards legal in a format (commander, modern, etc.)
  --exact             Exact name match only (for 'name' command)
  --sort <field>      Sort results by: name, cmc, price (default: database order; price desc for price command)
  --size <small|normal|large|png>  Image size for 'image' command (default: png)
  --out <dir>         Output directory for 'image' command (default: ~/Desktop)
  --border <black|silver>  Request a specific border colour for 'image'
  --format <fmt>      Output format: pretty | json | jsonl | csv | tsv
                      Default is auto-detected: pretty on a terminal, jsonl when
                      piped or redirected. Env override: SCRYFALL_FORMAT=<fmt>.
                      NO_COLOR=1 strips ANSI styling from pretty output.

Machine-readable output (json/jsonl/csv/tsv):
  When stdout is not a terminal — e.g. an LLM harness, script, or pipe — the
  tool emits compact JSONL automatically, one card per line, with stable fields:
  name, lang, mana_cost, cmc, type_line, colors, power, toughness, oracle_text,
  keywords, legalities, prices, image_uris, scryfall_uri. Warnings and status
  messages go to stderr so stdout stays pure data. 'fuzzy' becomes
  non-interactive: it returns the best match plus candidate suggestions instead
  of prompting. Pass --pretty to force human output even when piped.

Examples:
  scryfall name "Gilded Drake"
  scryfall text "create a treasure token"
  scryfall type "enchantment"
  scryfall color WG
  scryfall cmc <=3
  scryfall keyword flying
  scryfall random
  scryfall search "2 mana green creature"
  scryfall name "Sol Ring" --legal commander --limit 5
  scryfall fuzzy "sol rng"
  scryfall fuzzy "jac bele"
  scryfall price "Sol Ring"
  scryfall price "treasure" --sort price
  scryfall image "Sol Ring"
  scryfall image "sol rng" --size large
  scryfall search "counter target spell" --json | jq '.[].name'
  SCRYFALL_FORMAT=json scryfall price "Force of Will"   # for agents/harnesses
"""

import gzip
import json
import os
import re
import sys
import random as rng
import shutil
import time
import urllib.request
import urllib.parse
import urllib.error
import difflib

# ── Path to the Oracle cards cache ──────────────────────────────────────
ORACLE_PATH = os.path.expanduser("~/.hermes/scryfall/oracle-cards.jsonl")
DB_PATH = os.path.expanduser("~/.hermes/scryfall/oracle-cards.db")
SCHEMA_VERSION = "1"

# ── Output mode (resolved once at startup in main()) ────────────────────
MODE = "pretty"          # pretty | json | jsonl | csv | tsv
VALID_FORMATS = {"pretty", "json", "jsonl", "csv", "tsv"}

def machine_mode():
    return MODE != "pretty"

def resolve_format(explicit):
    """Decide output format. Priority: --format/--json/--pretty flag >
    $SCRYFALL_FORMAT env var > terminal auto-detection.

    Auto-detection is the human-vs-agent signal: a human typing in a terminal
    has a TTY on stdout and gets styled text; an LLM harness or script that
    captures output runs with stdout as a pipe and gets JSONL automatically.
    """
    if explicit:
        explicit = explicit.lower()
        if explicit not in VALID_FORMATS:
            # Unknown format value: emit structured error (stdout is still pure data)
            emit_single({"error": "invalid_format", "value": explicit,
                         "valid_formats": sorted(VALID_FORMATS)})
            sys.exit(1)
        return explicit
    env = os.environ.get("SCRYFALL_FORMAT", "").strip().lower()
    if env in VALID_FORMATS:
        return env
    try:
        if not sys.stdout.isatty():
            return "jsonl"
    except Exception:
        return "jsonl"
    return "pretty"

def _colors_enabled(fmt):
    """ANSI styling only for interactive pretty output."""
    if fmt != "pretty":
        return False
    if os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("TERM", "").lower() == "dumb":
        return False
    return True

USE_COLOR = True  # recomputed in main() after format resolution

def c(text, code):
    """Wrap text in ANSI codes unless colours are disabled. Coerces non-str."""
    text = str(text)
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text

def fmt(template, *args, **kw):
    """Format a template string with positional args (quote-safe inside c())."""
    return template.format(*args, **kw)

def warn(msg):
    """Status/warning line → stderr so stdout stays pure data in machine modes."""
    print(f"scryfall: {msg}", file=sys.stderr)

# ── Machine-readable projection of a card ───────────────────────────────
IMAGE_FIELDS = ("small", "normal", "large", "png")

def slim_card(card):
    """Project a card dict down to stable, LLM-useful fields (token-efficient)."""
    legalities = card.get("legalities", {})
    prices = card.get("prices", {})
    uris = card.get("image_uris") or {}
    if not uris and card.get("card_faces"):
        for face in card["card_faces"]:
            if face.get("image_uris"):
                uris = face["image_uris"]
                break
    image_uris = {k: uris[k] for k in IMAGE_FIELDS if uris.get(k)}

    def num(v):
        try:
            f = float(v)
            return int(f) if f == int(f) else f
        except (TypeError, ValueError):
            return None

    return {
        "name": card.get("name"),
        "lang": card.get("lang", "en"),
        "mana_cost": card.get("mana_cost", ""),
        "cmc": card.get("cmc"),
        "type_line": card.get("type_line", ""),
        "colors": card.get("colors", []),
        # color_identity is kept because display_card renders it and search_color
        # / --commander filter on it; dropping it blanks the colour line on
        # 32,199 of 38,708 cards once results come from the DB.
        "color_identity": card.get("color_identity", []),
        "power": card.get("power"),
        "toughness": card.get("toughness"),
        "oracle_text": card.get("oracle_text", ""),
        "keywords": card.get("keywords", []),
        "legalities": {f: legalities.get(f) for f in
                       ("standard", "future", "historic", "gladiator", "pioneer",
                        "modern", "legacy", "pauper", "vintage", "commander", "oathbreaker",
                        "standard_brawl", "future_brawl", "classic_brawl", "brawl",
                        "timeless", "bullet", "predh", "premodern") if f in legalities},
        "prices": {k: num(prices.get(k)) for k in ("usd", "usd_foil", "usd_etched", "eur", "eur_foil", "tix")
                   if prices.get(k) is not None},
        "image_uris": image_uris,
        "scryfall_uri": card.get("scryfall_uri", ""),
    }

CSV_COLUMNS = ["name", "lang", "mana_cost", "cmc", "type_line", "colors", "color_identity",
               "power", "toughness", "oracle_text", "keywords",
               "usd", "usd_foil", "eur", "tix", "scryfall_uri"]

def _csv_row(card):
    s = slim_card(card)
    p = s["prices"]
    return [s["name"], s["lang"], s["mana_cost"], s["cmc"], s["type_line"],
            "|".join(s["colors"]) or "", "|".join(s["color_identity"]) or "",
            s["power"] or "", s["toughness"] or "",
            (s["oracle_text"] or "").replace("\n", " "),
            "|".join(s["keywords"]),
            p.get("usd", ""), p.get("usd_foil", ""), p.get("eur", ""), p.get("tix", ""),
            s["scryfall_uri"]]

def emit_records(cards):
    """Write result cards to stdout in the active MODE (pretty handled elsewhere)."""
    import csv as _csv
    if MODE == "json":
        json.dump([slim_card(c_) for c_ in cards], sys.stdout, ensure_ascii=False, default=str)
        sys.stdout.write("\n")
    elif MODE == "jsonl":
        for c_ in cards:
            sys.stdout.write(json.dumps(slim_card(c_), ensure_ascii=False, default=str) + "\n")
    elif MODE in ("csv", "tsv"):
        writer = _csv.writer(sys.stdout, delimiter="," if MODE == "csv" else "\t",
                             lineterminator="\n")
        writer.writerow(CSV_COLUMNS)
        for c_ in cards:
            writer.writerow(_csv_row(c_))

def emit_single(payload):
    """Emit one structured object (used by fuzzy/image machine-mode paths)."""
    sys.stdout.write(json.dumps(payload, ensure_ascii=False, default=str) + "\n")

# ── SQLite sidecar (Option C, design doc §3) ────────────────────────────
# The JSONL stays canonical; this DB is a derived, rebuildable index.
# Stored `data` is exactly the slim_card() projection, so every output layer
# (display, json/jsonl/csv/tsv) sees what the JSONL path gives it. One field
# the filters need — color_identity — is NOT in slim_card() output, so it is
# promoted into its own indexed table rather than smuggled into `data`
# (which would change machine-mode output and break parity).

DB = None              # open sqlite3.Connection once load_cards() has run
DB_MODE = False        # True when queries are served from the sidecar
FORCE_NO_DB = False    # set by --no-db

def _sqlite_module():
    try:
        import sqlite3
        return sqlite3
    except ImportError:
        return None

def _sqlite_supports_fts5(sq):
    """True only if fts5 AND the trigram tokenizer both work in this build."""
    if sq is None:
        return False
    try:
        probe = sq.connect(":memory:")
        try:
            probe.execute("CREATE VIRTUAL TABLE _p USING fts5(x, tokenize='trigram')")
            return True
        finally:
            probe.close()
    except Exception:
        return False

def _fts_phrase(term):
    """Escape a user substring for use as a single trigram MATCH phrase."""
    return '"' + term.replace('"', '""') + '"'

def db_status():
    """Return (stale, reason) for the sidecar. Missing counts as stale."""
    if not os.path.exists(DB_PATH):
        return True, "missing"
    sq = _sqlite_module()
    if sq is None:
        return True, "sqlite3 unavailable"
    try:
        conn = sq.connect(DB_PATH)
        try:
            meta = dict(conn.execute("SELECT k, v FROM meta").fetchall())
        finally:
            conn.close()
    except Exception as e:
        return True, "unreadable (%s)" % e
    if meta.get("schema_version") != SCHEMA_VERSION:
        return True, "schema version %r (expected %r)" % (meta.get("schema_version"), SCHEMA_VERSION)
    try:
        st = os.stat(ORACLE_PATH)
    except OSError:
        return True, "source jsonl missing"
    if float(meta.get("source_mtime", -1)) != st.st_mtime:
        return True, "source mtime changed"
    if int(meta.get("source_size", -1)) != st.st_size:
        return True, "source size changed"
    return False, "fresh"

def build_db(verbose=True):
    """Build the sidecar from ORACLE_PATH: temp file + atomic swap.

    Concurrency (design doc §3, "swap-if-still-absent"): a best-effort O_EXCL
    lock stops parallel callers all burning a build. A caller that loses the
    race waits briefly, then uses whatever appeared or proceeds regardless —
    readers never see a partial DB because os.replace() swaps in a finished file.
    """
    sq = _sqlite_module()
    if sq is None:
        warn("sqlite3 is not available; cannot build index")
        return False
    cache_dir = os.path.dirname(DB_PATH)
    os.makedirs(cache_dir, exist_ok=True)
    lock_path = DB_PATH + ".lock"
    tmp_path = "%s.build.%d.tmp" % (DB_PATH, os.getpid())

    got_lock = False
    try:
        fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
        os.write(fd, str(os.getpid()).encode())
        os.close(fd)
        got_lock = True
    except FileExistsError:
        for _ in range(80):                      # up to ~20 s
            time.sleep(0.25)
            stale, _why = db_status()
            if not stale:
                if verbose:
                    warn("index build already running elsewhere; using completed DB")
                return True
            if not os.path.exists(lock_path):
                break                            # previous builder died; take over
        else:
            warn("timed out waiting for another build; proceeding anyway")
    except OSError as e:
        warn("could not create lock (%s); building without it" % e)

    try:
        st = os.stat(ORACLE_PATH)
        conn = sq.connect(tmp_path)
        try:
            conn.execute("CREATE TABLE meta(k TEXT PRIMARY KEY, v TEXT)")
            conn.execute("CREATE TABLE cards(rid INTEGER PRIMARY KEY, name TEXT,"
                         " name_lc TEXT NOT NULL, cmc REAL, lang TEXT, data TEXT NOT NULL)")
            conn.execute("CREATE VIRTUAL TABLE cards_ft USING fts5("
                         "name, oracle_text, type_line, tokenize='trigram')")
            conn.execute("CREATE TABLE colors(rid INTEGER NOT NULL, color TEXT NOT NULL)")

            rows, ft_rows, color_rows = [], [], []
            n = 0
            with open(ORACLE_PATH, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        raw = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    n += 1                       # rid == JSONL line order (§3)
                    s = slim_card(raw)
                    rows.append((n, s.get("name"), (s.get("name") or "").lower(),
                                 s.get("cmc"), s.get("lang", "en"),
                                 json.dumps(s, ensure_ascii=False)))
                    ft_rows.append((n, s.get("name") or "", s.get("oracle_text") or "",
                                    s.get("type_line") or ""))
                    # color_identity read from RAW: slim_card drops it, but
                    # search_color and --commander filter on it.
                    for col in (raw.get("color_identity") or []):
                        color_rows.append((n, col))

            conn.executemany("INSERT INTO cards VALUES(?,?,?,?,?,?)", rows)
            conn.executemany("INSERT INTO cards_ft(rowid,name,oracle_text,type_line)"
                             " VALUES(?,?,?,?)", ft_rows)
            conn.executemany("INSERT INTO colors VALUES(?,?)", color_rows)
            conn.execute("INSERT INTO meta VALUES('schema_version',?)", (SCHEMA_VERSION,))
            conn.execute("INSERT INTO meta VALUES('source_mtime',?)", (str(st.st_mtime),))
            conn.execute("INSERT INTO meta VALUES('source_size',?)", (str(st.st_size),))
            conn.execute("INSERT INTO meta VALUES('row_count',?)", (str(n),))
            conn.commit()
            for idx in ("CREATE INDEX cards_name_lc ON cards(name_lc)",
                        "CREATE INDEX cards_cmc ON cards(cmc)",
                        "CREATE INDEX colors_color ON colors(color)"):
                conn.execute(idx)
            conn.commit()
        finally:
            conn.close()
        os.replace(tmp_path, DB_PATH)
        if verbose:
            warn("✓ index built: %s cards, %.1f MB" %
                 (format(n, ","), os.path.getsize(DB_PATH) / (1024 * 1024)))
        return True
    except Exception as e:
        warn("index build failed: %s (using JSONL scan instead)" % e)
        try:
            os.remove(tmp_path)
        except OSError:
            pass
        return False
    finally:
        if got_lock:
            try:
                os.remove(lock_path)
            except OSError:
                pass

def open_db():
    """Open the sidecar for reading. Returns a connection or None."""
    sq = _sqlite_module()
    if sq is None or not _sqlite_supports_fts5(sq):
        return None
    try:
        conn = sq.connect(DB_PATH)
        conn.execute("PRAGMA query_only = ON")
        return conn
    except Exception as e:
        warn("could not open index (%s); using JSONL scan instead" % e)
        return None

# ── Colour symbols for display ──────────────────────────────────────────
COLOUR_SYMBOLS = {
    "W": "⚪", "U": "🔵", "B": "⚫", "R": "🔴", "G": "🟢"
}
COLOUR_NAMES = {
    "W": "White", "U": "Blue", "B": "Black", "R": "Red", "G": "Green"
}

# ── Load all cards into memory ──────────────────────────────────────────
CARDS = []

def load_cards():
    """Ensure card data is available.

    Preferred path (Option C): a fresh SQLite sidecar, opened read-only — no
    full parse, so startup costs an indexed query instead of ~1.3 s of JSON.
    Fallback: the original whole-file JSONL scan, used verbatim whenever the
    index is missing/stale/corrupt/unbuildable or --no-db was passed. The
    fallback never regresses behaviour; it is just slower.
    """
    global DB, DB_MODE
    if DB_MODE and DB is not None:
        return
    if CARDS:
        return
    if not os.path.exists(ORACLE_PATH):
        print(f"Error: Oracle cards file not found at {ORACLE_PATH}", file=sys.stderr)
        print("Run the Scryfall cache update first.", file=sys.stderr)
        sys.exit(1)

    if not FORCE_NO_DB:
        sq = _sqlite_module()
        if sq is not None and _sqlite_supports_fts5(sq):
            stale, reason = db_status()
            if stale and reason == "missing":
                build_db(verbose=True)            # transparent one-time build
                stale, reason = db_status()
            if not stale:
                conn = open_db()
                if conn is not None:
                    DB = conn
                    DB_MODE = True
                    return
        # sqlite absent / fts5 absent / stale-and-present / open failed → legacy
    _load_cards_jsonl()

def _load_cards_jsonl():
    """Legacy path: parse every line of the cache into CARDS."""
    global CARDS
    CARDS = []
    with open(ORACLE_PATH, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line:
                try:
                    CARDS.append(json.loads(line))
                except json.JSONDecodeError:
                    continue

# ── DB query helpers ────────────────────────────────────────────────────
def _hydrate(rows):
    """Turn rows of ('data' column) into card dicts, preserving row order."""
    return [json.loads(r[0]) for r in rows]

def _like_pattern(q):
    """LIKE pattern for a true substring match, with % and _ escaped."""
    return "%" + q.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%"

# Columns promoted to real table columns, for the sub-3-char LIKE fallback path.
# cards_ft column -> cards column (None = no cheap column, scan data instead).
_FT_TO_COL = {"name": "name_lc"}

def _substr_rows(ft_column, query):
    """Rows matching `query` as a true substring of one FTS-indexed field.

    Length-gated router (design doc §3.3): the trigram tokenizer needs >= 3
    characters and SILENTLY returns zero rows below that — measured on this
    cache, "a" gives 29,707 LIKE matches vs 0 from trigram, "so" 1,199 vs 0,
    "ri" 5,302 vs 0. So short queries must take the LIKE path, never FTS.
    """
    q = query.lower()
    if len(q) >= 3:
        sql = ("SELECT c.data FROM cards c JOIN cards_ft f ON f.rowid = c.rid"
               " WHERE f.%s MATCH ? ORDER BY c.rid" % ft_column)
        return DB.execute(sql, (_fts_phrase(q),)).fetchall()
    col = _FT_TO_COL.get(ft_column)
    if col:
        sql = "SELECT data FROM cards WHERE %s LIKE ? ESCAPE '\\' ORDER BY rid" % col
        return DB.execute(sql, (_like_pattern(q),)).fetchall()
    # No promoted column for this field (oracle_text/type_line): fall back to a
    # JSON-extract scan, which is still one pass, not 38k parses.
    key = {"oracle_text": "$.oracle_text", "type_line": "$.type_line"}[ft_column]
    sql = ("SELECT data FROM cards"
           " WHERE lower(json_extract(data, '%s')) LIKE ? ESCAPE '\\' ORDER BY rid" % key)
    return DB.execute(sql, (_like_pattern(q),)).fetchall()

def _any_substr_rows(query):
    """Rows whose name OR oracle text OR type line contains `query`."""
    q = query.lower()
    if len(q) >= 3:
        sql = ("SELECT c.data FROM cards c JOIN cards_ft f ON f.rowid = c.rid"
               " WHERE cards_ft MATCH ? ORDER BY c.rid")
        return DB.execute(sql, (_fts_phrase(q),)).fetchall()
    sql = ("SELECT data FROM cards WHERE name_lc LIKE :p ESCAPE '\\'"
           " OR lower(json_extract(data, '$.oracle_text')) LIKE :p ESCAPE '\\'"
           " OR lower(json_extract(data, '$.type_line')) LIKE :p ESCAPE '\\'"
           " ORDER BY rid")
    return DB.execute(sql, {"p": _like_pattern(q)}).fetchall()

# ── Display a single card ───────────────────────────────────────────────
def display_card(card, index=None):
    name = card.get("name", "Unknown")
    mana = card.get("mana_cost", "—")
    cmc = card.get("cmc", "?")
    cmc_display = int(cmc) if isinstance(cmc, (int, float)) and cmc == int(cmc) else cmc
    type_line = card.get("type_line", "—")
    oracle = card.get("oracle_text", "—")
    power = card.get("power")
    toughness = card.get("toughness")
    colors = card.get("color_identity", [])
    keywords = card.get("keywords", [])
    legalities = card.get("legalities", {})

    # Colour display
    colour_str = " ".join(COLOUR_SYMBOLS.get(c, c) for c in colors) if colors else "—"

    # P/T display
    pt = f" ({power}/{toughness})" if power and toughness else ""

    # Format legality badges
    legal_formats = [f for f, v in legalities.items() if v == "legal" and f in ("commander", "modern", "legacy", "pauper", "vintage")]
    legal_str = ", ".join(legal_formats) if legal_formats else "none"

    # Build output
    prefix = f"  [{index}] " if index is not None else "  "
    print('\n' + prefix + c(name, '1;33') + '  ' + mana + '  (CMC ' + str(cmc_display) + ')')
    print(f"       {type_line}{pt}")
    print(f"       {colour_str}")
    if keywords:
        print(f"       Keywords: {', '.join(keywords)}")
    print(f"       {oracle}")
    print(f"       Legal: {legal_str}")
    print(f"       {card.get('scryfall_uri', '')}")

# ── Search functions ────────────────────────────────────────────────────
# Each returns a list of card dicts in cache order, whether served from the
# sidecar (DB_MODE) or the legacy full-scan path. ORDER BY rid mirrors the
# JSONL line order so --limit tie-breaking inside sort_results (a stable sort)
# picks the same survivors as before.

def search_name(query, exact=False):
    query_lower = query.lower().strip('"')
    if DB_MODE:
        if exact:
            rows = DB.execute("SELECT data FROM cards WHERE name_lc = ? ORDER BY rid",
                              (query_lower,)).fetchall()
        else:
            rows = _substr_rows("name", query_lower)
        return _hydrate(rows)
    results = []
    for card in CARDS:
        name = card.get("name", "").lower()
        if exact:
            if name == query_lower:
                results.append(card)
        else:
            if query_lower in name:
                results.append(card)
    return results

def search_text(query):
    query_lower = query.lower()
    if DB_MODE:
        return _hydrate(_substr_rows("oracle_text", query_lower))
    results = []
    for card in CARDS:
        oracle = card.get("oracle_text", "").lower()
        if query_lower in oracle:
            results.append(card)
    return results

def search_type(query):
    query_lower = query.lower()
    if DB_MODE:
        return _hydrate(_substr_rows("type_line", query_lower))
    results = []
    for card in CARDS:
        type_line = card.get("type_line", "").lower()
        if query_lower in type_line:
            results.append(card)
    return results

def search_color(colors):
    """Search by colour identity. Accepts any combination of WUBRG letters.

    Raises ValueError on characters outside WUBRG so the caller can report
    a proper input-validation error instead of silently returning nothing.
    """
    colors_upper = set(colors.upper())
    invalid = colors_upper - set("WUBRG")
    if invalid:
        raise ValueError(
            f"invalid colour letter(s): {', '.join(sorted(invalid))}. "
            "Use only W, U, B, R, G (e.g. WG, BGR)."
        )
    if DB_MODE:
        # NB: use `rid IN (...)` subqueries, not a self-join. A self-join on
        # colors measured 4.9 s here; this form runs in ~11 ms.
        if not colors_upper:
            # Empty set is a subset of every colour identity (legacy semantics).
            return _hydrate(DB.execute("SELECT data FROM cards ORDER BY rid").fetchall())
        subs = " AND ".join(["rid IN (SELECT rid FROM colors WHERE color = ?)"] * len(colors_upper))
        sql = "SELECT data FROM cards WHERE %s ORDER BY rid" % subs
        return _hydrate(DB.execute(sql, tuple(sorted(colors_upper))).fetchall())
    results = []
    for card in CARDS:
        card_colors = set(card.get("color_identity", []))
        if colors_upper.issubset(card_colors):
            results.append(card)
    return results

def search_cmc(expr):
    """Search by CMC. Supports: =3, <=3, >=3, or just a number.

    Raises ValueError on an unparseable expression so the caller can report
    a proper input-validation error instead of silently returning nothing.
    """
    expr = expr.strip()

    if expr.startswith("<="):
        op, val_str = "<=", expr[2:]
    elif expr.startswith(">="):
        op, val_str = ">=", expr[2:]
    elif expr.startswith("="):
        op, val_str = "=", expr[1:]
    else:
        op, val_str = "=", expr

    try:
        val = float(val_str)
    except ValueError:
        raise ValueError(
            f"not a number: '{val_str.strip() or expr}'. "
            "Use an exact value (3), a comparison (<=3, >=3), or '=3'."
        )

    if val < 0:
        raise ValueError(f"mana value cannot be negative: {val}")

    if DB_MODE:
        # Every cached row has a numeric cmc, so the .get() defaults below
        # never fire on real data; SQL's NULL handling matches for that reason.
        col_op = {"<=": "<=", ">=": ">=", "=": "="}[op]
        sql = "SELECT data FROM cards WHERE cmc %s ? ORDER BY rid" % col_op
        return _hydrate(DB.execute(sql, (val,)).fetchall())

    if op == "<=":
        return [c for c in CARDS if c.get("cmc", 99) <= val]
    elif op == ">=":
        return [c for c in CARDS if c.get("cmc", 0) >= val]
    else:
        return [c for c in CARDS if c.get("cmc", -1) == val]

def search_keyword(query):
    query_lower = query.lower()
    if DB_MODE:
        # keywords are deliberately NOT in cards_ft: search_general's legacy
        # scope is name/oracle/type only, and indexing keywords made the FTS
        # MATCH pull in cards the old scan never returned (25 extra for
        # "treasure"). Match them from the JSON payload instead — substring
        # semantics per keyword element, same as the loop below.
        rows = DB.execute(
            "SELECT data FROM cards WHERE EXISTS ("
            "SELECT 1 FROM json_each(cards.data, '$.keywords') j"
            " WHERE lower(j.value) LIKE ? ESCAPE '\\') ORDER BY rid",
            (_like_pattern(query_lower),)).fetchall()
        return _hydrate(rows)
    results = []
    for card in CARDS:
        keywords = [k.lower() for k in card.get("keywords", [])]
        if any(query_lower in k for k in keywords):
            results.append(card)
    return results

def search_general(query):
    """Search across name, oracle text, and type line."""
    query_lower = query.lower()
    if DB_MODE:
        return _hydrate(_any_substr_rows(query_lower))
    results = []
    seen = set()
    for card in CARDS:
        card_id = card.get("id", "")
        if card_id in seen:
            continue
        name = card.get("name", "").lower()
        oracle = card.get("oracle_text", "").lower()
        type_line = card.get("type_line", "").lower()
        if query_lower in name or query_lower in oracle or query_lower in type_line:
            results.append(card)
            seen.add(card_id)
    return results

def search_random():
    if DB_MODE:
        row = DB.execute("SELECT data FROM cards ORDER BY RANDOM() LIMIT 1").fetchone()
        return _hydrate([row]) if row else []
    return [rng.choice(CARDS)]

# ── Scryfall API calls for fuzzy matching ─────────────────────────────
SCRYFALL_API = "https://api.scryfall.com"
USER_AGENT = "scryfall-cli/1.0"

def _api_get(endpoint, params=None):
    """Make a GET request to the Scryfall API. Returns parsed JSON or None."""
    url = f"{SCRYFALL_API}{endpoint}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        # Return the error body so callers can inspect it
        body = None
        try:
            body = json.loads(e.read().decode("utf-8"))
        except Exception:
            pass
        return {"error": True, "status": e.code, "body": body}
    except Exception as e:
        return {"error": True, "status": 0, "body": {"details": str(e)}}

def scryfall_fuzzy(name):
    """Fuzzy card lookup via /cards/named?fuzzy=. Returns card dict or error dict."""
    return _api_get("/cards/named", {"fuzzy": name})

def scryfall_autocomplete(query):
    """Autocomplete card names via /cards/autocomplete. Returns list of names or empty list."""
    result = _api_get("/cards/autocomplete", {"q": query})
    if result and not result.get("error") and "data" in result:
        return result["data"]
    return []

def handle_fuzzy(query, options=None):
    """Fuzzy search: try fuzzy → if ambiguous/no match, autocomplete → pick → lookup.

    In machine mode (json/jsonl/csv/tsv) it is fully non-interactive: emits a
    single JSON object {query, match, candidates} instead of prompting with
    input(), which would hang an LLM harness forever.
    """
    if not query:
        print("\n  Usage: scryfall fuzzy <card name>")
        return

    # Step 1: Try Scryfall fuzzy match
    if not machine_mode():
        print('\n  ' + c('Searching for:', '1') + ' \"' + query + '\"')
    result = scryfall_fuzzy(query)

    matched_name = None
    if result and not result.get("error"):
        name = result.get("name", "Unknown")
        if isinstance(name, str):
            # Sanity check: is the returned name actually similar to the query?
            ratio = difflib.SequenceMatcher(None, query.lower(), name.lower()).ratio()
            query_words = set(w.lower() for w in query.split() if len(w) >= 3)
            name_lower = name.lower()
            has_word_overlap = any(w in name_lower or name_lower.startswith(w[:4]) for w in query_words)

            if ratio >= 0.55 or has_word_overlap:
                matched_name = name
            else:
                # Fuzzy returned something unrelated — treat as no match
                if not machine_mode():
                    print("  " + c(fmt("~ Scryfall suggested '{}' but it doesn't match your query.", name), '1;33') + "\n")
        elif isinstance(name, list):
            # Ambiguous response — resolve to the closest candidate name
            chosen = _api_closest_match(result, query)
            if chosen:
                resolved = scryfall_fuzzy(chosen)
                if resolved and not resolved.get("error") and isinstance(resolved.get("name"), str):
                    result = resolved
                    matched_name = resolved["name"]

    # Step 2: Gather autocomplete suggestions (candidates)
    suggestions = []
    if matched_name is None and query.strip():
        # Scryfall's q= param treats leading "-" as negation; quote the query
        suggestions = scryfall_autocomplete('"' + query.strip('"') + '"')
    if matched_name is None and not suggestions:
        suggestions = scryfall_autocomplete(query)
        if not suggestions:
            words = [w for w in query.split() if len(w) >= 3]
            for word in words:
                suggestions = scryfall_autocomplete(word)
                if suggestions:
                    break

    # Step 2b: Local fallback — word-level typo matching against the cache
    # (rescues queries like "sol rng" / "jac bele" where Scryfall's own fuzzy
    # endpoint returns nothing useful)
    local_fallback_card = None
    if matched_name is None:
        candidate, sim = _resolve_card(query)
        if candidate is not None and sim >= 0.85:
            local_fallback_card = candidate

    # ── Machine mode: emit structured result, never prompt ──
    if machine_mode():
        card = None
        if local_fallback_card is not None:
            card = local_fallback_card
        elif matched_name:
            local = search_name(matched_name, exact=True)
            card = local[0] if local else (result if result and not result.get("error") else None)
        payload = {"query": query,
                   "match": slim_card(card) if card else None,
                   "candidates": suggestions[:10]}
        emit_single(payload)
        return

    if matched_name:
        print('  ' + c('✓ Found:', '1;32') + ' ' + matched_name + '\n')
        local = search_name(matched_name, exact=True)
        if local:
            display_card(local[0])
        else:
            display_api_card(result)
        return

    error_body = (result or {}).get("body", {}) or {}
    details = error_body.get("details", "")
    print('  ' + c('✗ No exact fuzzy match.', '1;31') + ' ' + details + '\n')

    if not suggestions:
        print("  No close matches found. Try a different spelling or use 'scryfall name' for partial search.")
        return

    # Step 3: Show suggestions and let user pick
    print("  " + c('Did you mean…', '1;36'))
    for i, name in enumerate(suggestions, 1):
        print(f"    [{i}] {name}")
    print(f"    [0] Cancel\n")

    try:
        choice = input("  Pick a number: ").strip()
        choice = int(choice)
    except (ValueError, EOFError):
        print("  Cancelled.")
        return

    if choice < 1 or choice > len(suggestions):
        print("  Cancelled.")
        return

    picked = suggestions[choice - 1]
    print('\n  ' + c('→ Looking up:', '1;32') + ' ' + picked + '\n')

    # Step 4: Lookup the picked card from local cache (exact)
    local = search_name(picked, exact=True)
    if local:
        display_card(local[0])
    else:
        # Fall back to API
        api_card = scryfall_fuzzy(picked)
        if api_card and not api_card.get("error"):
            display_api_card(api_card)
        else:
            print(f"  Could not find '{picked}' in cache or on Scryfall.")

def display_api_card(card):
    """Display a card from API JSON (same format as Oracle cache but may have extra fields)."""
    name = card.get("name", "Unknown")
    mana = card.get("mana_cost", "—")
    cmc = card.get("cmc", "?")
    cmc_display = int(cmc) if isinstance(cmc, (int, float)) and cmc == int(cmc) else cmc
    type_line = card.get("type_line", "—")
    oracle = card.get("oracle_text", "—")
    power = card.get("power")
    toughness = card.get("toughness")
    colors = card.get("color_identity", [])
    keywords = card.get("keywords", [])
    legalities = card.get("legalities", {})

    colour_str = " ".join(COLOUR_SYMBOLS.get(c, c) for c in colors) if colors else "—"
    pt = f" ({power}/{toughness})" if power and toughness else ""
    legal_formats = [f for f, v in legalities.items() if v == "legal" and f in ("commander", "modern", "legacy", "pauper", "vintage")]
    legal_str = ", ".join(legal_formats) if legal_formats else "none"

    print('\n  ' + c(name, '1;33') + '  ' + mana + '  (CMC ' + str(cmc_display) + ')')
    print(f"       {type_line}{pt}")
    print(f"       {colour_str}")
    if keywords:
        print(f"       Keywords: {', '.join(keywords)}")
    print(f"       {oracle}")
    print(f"       Legal: {legal_str}")
    print(f"       {card.get('scryfall_uri', '')}")

# ── Price display ─────────────────────────────────────────────────────
def format_price(value, symbol="$"):
    """Format a price string with currency symbol, or return '—' for None/null."""
    if value is None:
        return "—"
    try:
        amount = float(value)
        return f"{symbol}{amount:,.2f}"
    except (ValueError, TypeError):
        return "—"

def display_price_card(card, index=None):
    """Display a card with prices prominent."""
    name = card.get("name", "Unknown")
    mana = card.get("mana_cost", "—")
    type_line = card.get("type_line", "—")
    cmc = card.get("cmc", "?")
    cmc_display = int(cmc) if isinstance(cmc, (int, float)) and cmc == int(cmc) else cmc
    colors = card.get("color_identity", [])
    prices = card.get("prices", {})

    colour_str = " ".join(COLOUR_SYMBOLS.get(c, c) for c in colors) if colors else "—"

    usd = format_price(prices.get("usd"), "$")
    usd_foil = format_price(prices.get("usd_foil"), "$")
    eur = format_price(prices.get("eur"), "€")
    eur_foil = format_price(prices.get("eur_foil"), "€")
    tix = format_price(prices.get("tix"), "")

    prefix = f"  [{index}] " if index is not None else "  "
    print('\n' + prefix + c(name, '1;33') + '  ' + mana + '  (CMC ' + str(cmc_display) + ')')
    print(f"       {type_line}  •  {colour_str}")

    # Price line — only show foil if it has a value
    usd_part = f"USD {usd}"
    if usd_foil != "—":
        usd_part += f" (foil {usd_foil})"
    eur_part = f"EUR {eur}"
    if eur_foil != "—":
        eur_part += f" (foil {eur_foil})"
    tix_part = f"TIX {tix}"

    print('       ' + c(usd_part, '1;32') + '  •  ' + eur_part + '  •  ' + tix_part)
    print(f"       {card.get('scryfall_uri', '')}")

# ── Image download ──────────────────────────────────────────────────────
def _safe_filename(name):
    """Turn a card name into a safe filename (keep spaces, strip path chars)."""
    cleaned = re.sub(r'[<>:"/\\|?*\x00-\x1f]', "", name)
    return cleaned.strip() or "card"

def _pick_image(card, size="png", border=None):
    """Pick an image URI from a card dict. Returns (uri, ext) or (None, None)."""
    uris = card.get("image_uris") or {}
    # Some special cards (tokens, double-faced backs) store per-face URIs in
    # `card_faces`. Fall back to the first face that has images.
    if not uris and card.get("card_faces"):
        for face in card["card_faces"]:
            if face.get("image_uris"):
                uris = face["image_uris"]
                break

    if not uris:
        return None, None

    # Order of preference by requested size
    order = {
        "small": ["small", "normal", "large", "png"],
        "normal": ["normal", "large", "png", "small"],
        "large": ["large", "png", "normal", "small"],
        "png": ["png", "large", "normal", "small"],
    }.get(size, ["png", "large", "normal", "small"])

    uri = next((uris[k] for k in order if uris.get(k)), None)
    if not uri:
        return None, None

    # Determine extension from the URL itself (e.g. .png vs .jpg)
    path = urllib.parse.urlparse(uri).path.lower()
    ext = ".png" if path.endswith(".png") else (".jpg" if path.endswith(".jpg") else ".bin")
    return uri, ext

def _similarity(query, name):
    """Similarity score of query vs card name (0..1), with word-start bonus."""
    q, n = query.lower(), name.lower()
    ratio = difflib.SequenceMatcher(None, q, n).ratio()
    # Bonus if every query word lines up with a word in the name
    q_words = [w for w in re.split(r'\s+', q) if w]
    n_words = re.split(r'\s+', n)
    if q_words and all(any(nw.startswith(qw) or qw.startswith(nw) for nw in n_words) for qw in q_words):
        return max(ratio, 0.95)
    # Typo-tolerant: most query words found inside the name (e.g. "sol rng" → Sol Ring)
    contained = sum(1 for qw in q_words if len(qw) >= 2 and qw in n)
    if q_words and contained / len(q_words) >= 0.75:
        return max(ratio, 0.85)
    return ratio

def _normalize_name(name):
    """Lowercase, drop punctuation — used for closest-match comparison."""
    return re.sub(r"[\u2019'\".,!?|()/\\:-]", "", name.lower()).strip()

def _api_closest_match(card, query):
    """If the API returned an ambiguous result, pick the closest 'name' from its list."""
    candidates = card.get("name")
    if not isinstance(candidates, list) or not candidates:
        return None
    q_norm = _normalize_name(query)
    best = max(candidates, key=lambda c: _similarity(q_norm, _normalize_name(c)))
    return best if _similarity(q_norm, _normalize_name(best)) >= 0.6 else None

def _all_db_cards():
    """Every cached card as dicts, cache order. Used only by rare fallbacks."""
    return _hydrate(DB.execute("SELECT data FROM cards ORDER BY rid").fetchall())

def _typo_candidates(words):
    """Cards whose name shares a >=3-char substring with any of `words`.

    Union of per-word trigram matches — a superset of the difflib-ratio>=0.6
    set for words of that length, so it can over-select but never miss a
    candidate the old full scan would have found.
    """
    seen, out = set(), []
    for w in words:
        for row in DB.execute(
                "SELECT c.rid, c.data FROM cards c JOIN cards_ft f ON f.rowid = c.rid"
                " WHERE f.name MATCH ? ORDER BY c.rid", (_fts_phrase(w),)):
            if row[0] not in seen:
                seen.add(row[0])
                out.append(json.loads(row[1]))
    return out

def _resolve_card(query):
    """Resolve a card name to (card, similarity). Shared by image + machine paths."""
    # Step 1: Scryfall fuzzy lookup (handles typos + gives us image URLs)
    api_card = scryfall_fuzzy(query)
    if api_card and api_card.get("error"):
        api_card = None
    if api_card and isinstance(api_card.get("name"), list):
        # Ambiguous match — API returned several candidate names; pick the best one
        chosen = _api_closest_match(api_card, query)
        api_card = scryfall_fuzzy(chosen) if chosen else None
        if api_card and api_card.get("error"):
            api_card = None
    # Guard against unrelated printed-name coincidences (e.g. fuzzy "sol rng"
    # returning a Portuguese card whose printed name starts with "Sol R")
    if api_card and not isinstance(api_card.get("name"), list):
        if _similarity(query, api_card.get("name", "")) < 0.55:
            api_card = None

    # Step 2: Local cache candidates (exact match wins outright)
    local_exact = search_name(query, exact=True)
    local_partial = [] if local_exact else search_name(query)

    # Step 3: Typo tolerance — match each query word against cached card names
    local_typo = []
    if not local_exact and not local_partial and len(query.split()) >= 2:
        q_words = [w.lower() for w in re.split(r'\s+', query) if len(w) >= 2]
        # Candidate pool. Scoring all 38,708 names with difflib measured 778 ms,
        # which alone would swamp a ~40 ms call, so under DB_MODE we first take
        # the union of per-word trigram matches (each word shares >= 3 chars with
        # a name word => it is in that word's trigram set => substring match on
        # the FTS index finds it). Words shorter than 3 chars can't be routed
        # through trigram, so any such word falls back to the full scan rather
        # than risking a missed candidate — correctness over speed here.
        if DB_MODE and q_words and all(len(w) >= 3 for w in q_words):
            pool = _typo_candidates(q_words)
        else:
            pool = CARDS if not DB_MODE else _all_db_cards()
        for card in pool:
            n_words = re.split(r'\s+', card.get("name", "").lower())
            hits = sum(1 for qw in q_words
                       if any(difflib.SequenceMatcher(None, qw, nw).ratio() >= 0.6 for nw in n_words))
            if hits == len(q_words):
                local_typo.append(card)

    card = None
    sim = 0.0
    if local_exact:
        card = local_exact[0]
        sim = 1.0
    elif api_card and not isinstance(api_card.get("name"), list):
        sim = _similarity(query, api_card.get("name", ""))
        card = api_card
    elif local_typo:
        best = max(local_typo, key=lambda c: _similarity(query, c.get("name", "")))
        card = best
        sim = _similarity(query, best.get("name", ""))

    # Step 4: Fall back to the best partial match from the local cache
    if card is None and local_partial:
        best = max(local_partial, key=lambda c: _similarity(query, c.get("name", "")))
        card = best
        sim = _similarity(query, best.get("name", ""))

    return card, sim

def handle_image(query, options):
    """Resolve a card name and download its image."""
    query = query.strip().strip('"')
    if not query:
        print("\n  Usage: scryfall image <card name> [--size small|normal|large|png] [--out <dir>] [--border black|silver]\n")
        return

    size = options.get("size", "png")
    out_dir = os.path.expanduser(options.get("out") or "~/Desktop")
    border = options.get("border")

    card, sim = _resolve_card(query)

    if card is None:
        if machine_mode():
            emit_single({"query": query, "saved": None, "error": "not_found"})
        else:
            print("\n  " + c(fmt("✗ Could not find a card matching '{}'.", query), '1;31') + "\n")
        return

    name = card.get("name", "Unknown")
    if not machine_mode():
        note = "" if sim >= 0.9 else "  " + c(fmt("(from '{}')", query), '2')
        print('\n  ' + c('Card:', '1') + ' ' + name + note)

    # If a border is requested, ask the API for that specific version
    if border:
        set_code = (card.get("set") or "").upper()
        api_card = _api_get("/cards/named", {"exact": name, "set": set_code}) if set_code else None
        if api_card and not api_card.get("error") and api_card.get("border") == border:
            card = api_card
        else:
            warn(f"no {border}-border version found; using default")

    uri, ext = _pick_image(card, size=size)
    if not uri:
        if machine_mode():
            emit_single({"query": query, "name": name, "saved": None, "error": "no_image"})
        else:
            print('  ' + c('✗ No image available for this card.', '1;31') + '\n')
        return

    # Build output path — avoid clobbering existing files
    os.makedirs(out_dir, exist_ok=True)
    base = _safe_filename(name)
    out_path = os.path.join(out_dir, f"{base}{ext}")
    counter = 1
    while os.path.exists(out_path):
        out_path = os.path.join(out_dir, f"{base} ({counter}){ext}")
        counter += 1

    if not machine_mode():
        print('  ' + c('Source:', '2') + ' ' + uri)
    try:
        req = urllib.request.Request(uri, headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=60) as resp, open(out_path, "wb") as f:
            shutil.copyfileobj(resp, f)
    except Exception as e:
        if machine_mode():
            emit_single({"query": query, "name": name, "source_uri": uri,
                         "saved": None, "error": f"download_failed: {e}"})
        else:
            print('  ' + c('✗ Download failed: ' + str(e), '1;31') + '\n')
        return

    if machine_mode():
        emit_single({"query": query, "name": name, "source_uri": uri,
                     "saved": out_path, "bytes": os.path.getsize(out_path), "error": None})
    else:
        size_kb = os.path.getsize(out_path) / 1024
        print('  ' + c('✓ Saved:', '1;32') + ' ' + out_path + '  (' + c(str(round(size_kb)) + ' KB', '2') + ')\n')

# ── Apply filters ───────────────────────────────────────────────────────
def apply_filters(results, commander=None, legal=None):
    if commander:
        allowed = set(commander.upper())
        results = [c for c in results if set(c.get("color_identity", [])).issubset(allowed)]
    if legal:
        legal = legal.lower()
        results = [c for c in results if c.get("legalities", {}).get(legal) == "legal"]
    return results

# ── Parse arguments ─────────────────────────────────────────────────────
def parse_args(args):
    """Parse command line arguments into (command, query, options)."""
    global FORCE_NO_DB
    command = None
    query_parts = []
    options = {"limit": 10, "commander": None, "legal": None, "exact": False, "sort": None,
               "size": None, "out": None, "border": None, "format": None}

    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--limit" and i + 1 < len(args):
            try:
                options["limit"] = max(0, int(args[i + 1]))
            except ValueError:
                pass
            i += 2
        elif arg == "--commander" and i + 1 < len(args):
            options["commander"] = args[i + 1]
            i += 2
        elif arg == "--legal" and i + 1 < len(args):
            options["legal"] = args[i + 1]
            i += 2
        elif arg == "--exact":
            options["exact"] = True
            i += 1
        elif arg == "--sort" and i + 1 < len(args):
            options["sort"] = args[i + 1].lower()
            i += 2
        elif arg == "--size" and i + 1 < len(args):
            options["size"] = args[i + 1].lower()
            i += 2
        elif arg == "--out" and i + 1 < len(args):
            options["out"] = args[i + 1]
            i += 2
        elif arg == "--border" and i + 1 < len(args):
            options["border"] = args[i + 1].lower()
            i += 2
        elif arg == "--format" and i + 1 < len(args):
            options["format"] = args[i + 1].lower()
            i += 2
        elif arg in ("--json", "-j"):
            options["format"] = "json"
            i += 1
        elif arg == "--jsonl":
            options["format"] = "jsonl"
            i += 1
        elif arg == "--csv":
            options["format"] = "csv"
            i += 1
        elif arg == "--tsv":
            options["format"] = "tsv"
            i += 1
        elif arg == "--pretty":
            options["format"] = "pretty"
            i += 1
        elif arg == "--no-db":
            # Escape hatch: force the legacy JSONL scan path (debugging/parity).
            FORCE_NO_DB = True
            i += 1
        elif arg.startswith("--"):
            # Unknown flag: emit structured error (stdout is still pure data)
            emit_single({"error": "unknown_flag", "flag": arg})
            sys.exit(1)
        elif command is None:
            command = arg.lower()
            i += 1
        else:
            query_parts.append(arg)
            i += 1

    query = " ".join(query_parts) if query_parts else ""
    return command, query, options

# ── Update cache ─────────────────────────────────────────────────────
def handle_update():
    """Download the latest Oracle Cards bulk data from Scryfall."""
    cache_dir = os.path.dirname(ORACLE_PATH)
    os.makedirs(cache_dir, exist_ok=True)

    gz_path = ORACLE_PATH + ".gz"
    backup_path = ORACLE_PATH + ".backup"

    # 1. Get the download URL
    warn("Fetching Scryfall bulk-data catalogue...")
    try:
        req = urllib.request.Request(
            "https://api.scryfall.com/bulk-data",
            headers={"User-Agent": "scryfall-cli/1.0", "Accept": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            bulk_data = json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        warn('✗ Failed to fetch catalogue: ' + str(e))
        sys.exit(1)

    download_url = None
    for item in bulk_data.get("data", []):
        if item.get("type") == "oracle_cards":
            download_url = item.get("jsonl_download_uri")
            break

    if not download_url:
        warn('✗ Could not find oracle_cards download URL.')
        sys.exit(1)

    # 2. Download the gzipped file
    warn(f"Downloading from:\n  {download_url}")
    try:
        req = urllib.request.Request(
            download_url,
            headers={"User-Agent": "scryfall-cli/1.0"},
        )
        with urllib.request.urlopen(req, timeout=300) as resp:
            with open(gz_path, "wb") as f:
                shutil.copyfileobj(resp, f)
    except Exception as e:
        warn('✗ Download failed: ' + str(e))
        sys.exit(1)

    if os.path.getsize(gz_path) == 0:
        os.remove(gz_path)
        warn('✗ Downloaded file is empty.')
        sys.exit(1)

    # 3. Decompress and replace
    warn("Decompressing...")
    try:
        # Back up existing cache
        if os.path.exists(ORACLE_PATH):
            shutil.copy2(ORACLE_PATH, backup_path)

        with gzip.open(gz_path, "rb") as f_in:
            with open(ORACLE_PATH, "wb") as f_out:
                shutil.copyfileobj(f_in, f_out)

        os.remove(gz_path)
    except Exception as e:
        # Restore backup on failure
        if os.path.exists(backup_path):
            shutil.move(backup_path, ORACLE_PATH)
        if os.path.exists(gz_path):
            os.remove(gz_path)
        warn('✗ Decompression failed: ' + str(e))
        sys.exit(1)

    # 4. Count and report
    line_count = 0
    with open(ORACLE_PATH, "r", encoding="utf-8") as f:
        for line in f:
            if line.strip():
                line_count += 1

    file_size = os.path.getsize(ORACLE_PATH)
    size_mb = file_size / (1024 * 1024)
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")

    # Clean up backup
    if os.path.exists(backup_path):
        os.remove(backup_path)

    print('\n  ' + c('✓ Oracle cache updated: ' + timestamp, '1;32'), file=sys.stderr)
    print(f"    File:  {ORACLE_PATH}", file=sys.stderr)
    print(f"    Size:  {size_mb:.1f} MB", file=sys.stderr)
    print(f"    Cards: {line_count:,}\n", file=sys.stderr)

    # Refresh the derived search index so queries stay fast after an update.
    if _sqlite_supports_fts5(_sqlite_module()):
        warn("Rebuilding search index...")
        build_db(verbose=True)
    else:
        warn("sqlite3/FTS5 unavailable in this Python build;"
             " queries will use the JSONL scan path.")

VALID_COMMANDS = {"name", "text", "type", "color", "cmc", "keyword", "fuzzy", "random",
                  "search", "price", "image", "update", "reindex", "doctor"}

# ── Index maintenance commands (Option C) ───────────────────────────────
def handle_reindex():
    """Rebuild the SQLite sidecar from the JSONL cache."""
    if not os.path.exists(ORACLE_PATH):
        warn("Oracle cache not found at %s — run 'scryfall update' first." % ORACLE_PATH)
        sys.exit(1)
    sq = _sqlite_module()
    if sq is None or not _sqlite_supports_fts5(sq):
        warn("this Python build has no sqlite3/FTS5+trigram support; nothing to index.")
        warn("Queries will keep using the JSONL scan path.")
        sys.exit(1)
    t0 = time.time()
    if not build_db(verbose=True):
        sys.exit(1)
    warn("reindex took %.2fs" % (time.time() - t0))

def handle_doctor():
    """Report index health: staleness, schema version, FTS5, row-count parity."""
    sq = _sqlite_module()
    fts_ok = _sqlite_supports_fts5(sq)
    stale, reason = db_status()
    lines = []
    lines.append(("jsonl", "%s" % ORACLE_PATH))
    lines.append(("jsonl size", "%.1f MB" % (os.path.getsize(ORACLE_PATH) / (1024*1024))
                  if os.path.exists(ORACLE_PATH) else "MISSING"))
    lines.append(("sqlite3", "available (%s)" % sq.sqlite_version if sq else "UNAVAILABLE"))
    lines.append(("fts5 + trigram", "ok" if fts_ok else "unavailable -> JSONL path"))
    if os.path.exists(DB_PATH):
        lines.append(("index", DB_PATH))
        lines.append(("index size", "%.1f MB (+ WAL siblings while open)" %
                      (os.path.getsize(DB_PATH) / (1024*1024))))
        lines.append(("status", "fresh" if not stale else "STALE: %s" % reason))
        try:
            conn = sq.connect(DB_PATH)
            meta = dict(conn.execute("SELECT k, v FROM meta").fetchall())
            db_rows = conn.execute("SELECT count(*) FROM cards").fetchone()[0]
            ft_rows = conn.execute("SELECT count(*) FROM cards_ft").fetchone()[0]
            color_rows = conn.execute("SELECT count(*) FROM colors").fetchone()[0]
            conn.close()
            jsonl_rows = 0
            if os.path.exists(ORACLE_PATH):
                with open(ORACLE_PATH, "rb") as f:
                    for chunk in iter(lambda: f.read(1 << 20), b""):
                        jsonl_rows += chunk.count(b"\n")
            lines.append(("schema_version", "%s (expected %s)" %
                          (meta.get("schema_version"), SCHEMA_VERSION)))
            lines.append(("rows indexed", "%s vs %s jsonl lines%s" %
                          (format(db_rows, ","), format(jsonl_rows, ","),
                           "" if db_rows == jsonl_rows else "   <-- MISMATCH (truncated build?)")))
            if ft_rows != db_rows:
                lines.append(("fts rows", "%s != cards %s  <-- MISMATCH" %
                              (format(ft_rows, ","), format(db_rows, ","))))
            lines.append(("colour rows", format(color_rows, ",")))
        except Exception as e:
            lines.append(("index read", "FAILED: %s" % e))
    else:
        lines.append(("index", "not built yet (runs automatically on next query,"
                               " or 'scryfall reindex')"))

    use_db = bool(sq and fts_ok and not stale and os.path.exists(DB_PATH))
    lines.append(("queries would use", "SQLite index" if use_db else "JSONL full scan"))
    width = max(len(k) for k, _ in lines)
    print()
    for k, v in lines:
        print("  " + c(k.ljust(width), '1') + "  " + str(v))
    print()

def sort_results(results, sort_key):
    """Sort results by the given key."""
    if sort_key == "name":
        return sorted(results, key=lambda c: c.get("name", "").lower())
    elif sort_key == "cmc":
        return sorted(results, key=lambda c: c.get("cmc", 0))
    elif sort_key == "price":
        def usd_val(c):
            p = c.get("prices", {}).get("usd")
            return float(p) if p else 0
        return sorted(results, key=usd_val, reverse=True)
    else:
        warn(fmt("⚠ Unknown sort field '{}'. Use 'name', 'cmc', or 'price'.", sort_key))
        return results

# ── Main ────────────────────────────────────────────────────────────────
def main():
    global MODE, USE_COLOR

    if len(sys.argv) < 2:
        print(__doc__)
        return

    command, query, options = parse_args(sys.argv[1:])

    # Resolve output format: flag > $SCRYFALL_FORMAT > TTY auto-detect
    MODE = resolve_format(options.get("format"))
    USE_COLOR = _colors_enabled(MODE)

    # Handle update command (doesn't need card data)
    if command == "update":
        handle_update()
        return

    # Index maintenance (doesn't need card data loaded)
    if command == "reindex":
        handle_reindex()
        return
    if command == "doctor":
        handle_doctor()
        return

    # Handle image command (uses API first, local cache as fallback)
    if command == "image":
        load_cards()
        handle_image(query, options)
        return

    # Validate command (#4)
    if command and command not in VALID_COMMANDS:
        if machine_mode():
            emit_single({"error": "unknown_command", "command": command,
                         "valid_commands": sorted(VALID_COMMANDS - {"update"})})
        else:
            print("\n  " + c(fmt("✗ Unknown command '{}'.", command), '1;31'))
            print(f"  Valid commands: {', '.join(sorted(VALID_COMMANDS - {'update'}))}")
            print(f"  Use 'scryfall search \"{command} {query}\"' for a general search.\n")
        sys.exit(1)

    # Guard empty queries (#1) — except random which needs no query
    if command != "random" and not query.strip():
        if machine_mode():
            emit_single({"error": "empty_query", "command": command})
        else:
            print('\n  ' + c('✗ No search query provided.', '1;31'))
            print(f"  Usage: scryfall {command} <query>\n")
        sys.exit(1)

    # Load cards
    load_cards()

    # Run search
    results = []
    if command == "name":
        results = search_name(query, exact=options["exact"])
    elif command == "fuzzy":
        handle_fuzzy(query, options)
        return
    elif command == "text":
        results = search_text(query)
    elif command == "type":
        results = search_type(query)
    elif command == "color":
        try:
            results = search_color(query)
        except ValueError as e:
            if machine_mode():
                emit_single({"error": "invalid_color", "query": query, "details": str(e)})
            else:
                print("\n  " + c(fmt("✗ Invalid colour: {}", e), '1;31'))
                print("  Usage: scryfall color W | scryfall color WG | scryfall color BGR\n")
            sys.exit(1)
    elif command == "cmc":
        try:
            results = search_cmc(query)
        except ValueError as e:
            if machine_mode():
                emit_single({"error": "invalid_cmc", "query": query, "details": str(e)})
            else:
                print("\n  " + c(fmt("✗ Invalid mana value: {}", e), '1;31'))
                print("  Usage: scryfall cmc 3 | scryfall cmc <=3 | scryfall cmc >=3\n")
            sys.exit(1)
    elif command == "keyword":
        results = search_keyword(query)
    elif command == "random":
        results = search_random()
    elif command == "search":
        results = search_general(query)
    elif command == "price":
        results = search_name(query, exact=options["exact"])
        # Default to price-sorted (most expensive first) when no sort specified
        if not options["sort"]:
            options["sort"] = "price"
        if machine_mode():
            # Numeric prices for clean comparisons; keep every field from the projector
            for r in results:
                p = r.get("prices", {})
                for k in ("usd", "usd_foil", "usd_etched", "eur", "eur_foil", "tix"):
                    try:
                        p[k] = float(p[k]) if p.get(k) is not None else None
                    except (TypeError, ValueError):
                        p[k] = None

    # Apply filters
    results = apply_filters(results, commander=options["commander"], legal=options["legal"])

    # Apply sort (#5)
    if options["sort"]:
        results = sort_results(results, options["sort"])

    limit = options["limit"]
    total = len(results)
    shown = min(limit, total)

    # ── Machine-readable output: stdout is pure data, meta goes to stderr ──
    if machine_mode():
        if total > shown:
            warn(f"{shown} of {total} matches shown (use --limit {total} for all)")
        emit_records(results[:shown])
        return

    # Display
    if not results:
        print(f"\n  No cards found matching your search.")
        return

    if total > shown:
        print(f"\n  Showing {shown} of {total} results (use --limit {total} to see all):")
    else:
        print(f"\n  Found {total} result{'s' if total != 1 else ''}:")

    display_fn = display_price_card if command == "price" else display_card
    for i, card in enumerate(results[:shown], 1):
        display_fn(card, index=i)

    print()  # trailing newline

if __name__ == "__main__":
    main()
