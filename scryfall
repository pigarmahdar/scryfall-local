#!/usr/bin/env python3
"""
scryfall — Local MTG card search from your Oracle cache.
Usage:
  scryfall <command> <query> [options]

Commands:
  name <query>        Search by card name (partial match)
  text <query>        Search by oracle text (what the card does)
  type <query>        Search by type line (creature, enchantment, etc.)
  color <W|U|B|R|G>  Search by colour identity (combine letters, e.g. WG)
  cmc <number>        Search by mana value (exact or <=  / >=)
  keyword <query>     Search by keyword (Flying, Trample, etc.)
  fuzzy <query>        Fuzzy name search (handles typos, partial names)
  random              Get a random card
  search <query>      General search across name + text + type
  price <query>       Search by name, showing market prices
  image <name>        Download PNG image of a card (to Desktop by default)
  update              Update the Oracle cache from Scryfall

Options:
  --limit N           Max results (default: 10)
  --commander <WUBRG> Cards whose colour identity fits within these colours
  --legal <format>    Only cards legal in a format (commander, modern, etc.)
  --exact             Exact name match only (for 'name' command)
  --sort <field>      Sort results by: name, cmc, price (default: database order; price desc for price command)
  --size <small|normal|large|png>  Image size for 'image' command (default: png)
  --out <dir>         Output directory for 'image' command (default: ~/Desktop)
  --border <black|silver>  Request a specific border colour for 'image'
  --format <fmt>      Output format: pretty | json | jsonl | csv | tsv
                      Default is auto-detected: pretty on a terminal, jsonl when
                      piped or redirected. Env override: SCRYFALL_FORMAT=<fmt>.
                      NO_COLOR=1 strips ANSI styling from pretty output.

Machine-readable output (json/jsonl/csv/tsv):
  When stdout is not a terminal — e.g. an LLM harness, script, or pipe — the
  tool emits compact JSONL automatically, one card per line, with stable fields:
  name, lang, mana_cost, cmc, type_line, colors, power, toughness, oracle_text,
  keywords, legalities, prices, image_uris, scryfall_uri. Warnings and status
  messages go to stderr so stdout stays pure data. 'fuzzy' becomes
  non-interactive: it returns the best match plus candidate suggestions instead
  of prompting. Pass --pretty to force human output even when piped.

Examples:
  scryfall name "Gilded Drake"
  scryfall text "create a treasure token"
  scryfall type "enchantment"
  scryfall color WG
  scryfall cmc <=3
  scryfall keyword flying
  scryfall random
  scryfall search "2 mana green creature"
  scryfall name "Sol Ring" --legal commander --limit 5
  scryfall fuzzy "sol rng"
  scryfall fuzzy "jac bele"
  scryfall price "Sol Ring"
  scryfall price "treasure" --sort price
  scryfall image "Sol Ring"
  scryfall image "sol rng" --size large
  scryfall search "counter target spell" --json | jq '.[].name'
  SCRYFALL_FORMAT=json scryfall price "Force of Will"   # for agents/harnesses
"""

import gzip
import json
import os
import re
import sys
import random as rng
import shutil
import time
import urllib.request
import urllib.parse
import urllib.error
import difflib

# ── Path to the Oracle cards cache ──────────────────────────────────────
ORACLE_PATH = os.path.expanduser("~/.hermes/scryfall/oracle-cards.jsonl")

# ── Output mode (resolved once at startup in main()) ────────────────────
MODE = "pretty"          # pretty | json | jsonl | csv | tsv
VALID_FORMATS = {"pretty", "json", "jsonl", "csv", "tsv"}

def machine_mode():
    return MODE != "pretty"

def resolve_format(explicit):
    """Decide output format. Priority: --format/--json/--pretty flag >
    $SCRYFALL_FORMAT env var > terminal auto-detection.

    Auto-detection is the human-vs-agent signal: a human typing in a terminal
    has a TTY on stdout and gets styled text; an LLM harness or script that
    captures output runs with stdout as a pipe and gets JSONL automatically.
    """
    if explicit and explicit.lower() in VALID_FORMATS:
        return explicit.lower()
    env = os.environ.get("SCRYFALL_FORMAT", "").strip().lower()
    if env in VALID_FORMATS:
        return env
    try:
        if not sys.stdout.isatty():
            return "jsonl"
    except Exception:
        return "jsonl"
    return "pretty"

def _colors_enabled(fmt):
    """ANSI styling only for interactive pretty output."""
    if fmt != "pretty":
        return False
    if os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("TERM", "").lower() == "dumb":
        return False
    return True

USE_COLOR = True  # recomputed in main() after format resolution

def c(text, code):
    """Wrap text in ANSI codes unless colours are disabled. Coerces non-str."""
    text = str(text)
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text

def fmt(template, *args, **kw):
    """Format a template string with positional args (quote-safe inside c())."""
    return template.format(*args, **kw)

def warn(msg):
    """Status/warning line → stderr so stdout stays pure data in machine modes."""
    print(f"scryfall: {msg}", file=sys.stderr)

# ── Machine-readable projection of a card ───────────────────────────────
IMAGE_FIELDS = ("small", "normal", "large", "png")

def slim_card(card):
    """Project a card dict down to stable, LLM-useful fields (token-efficient)."""
    legalities = card.get("legalities", {})
    prices = card.get("prices", {})
    uris = card.get("image_uris") or {}
    if not uris and card.get("card_faces"):
        for face in card["card_faces"]:
            if face.get("image_uris"):
                uris = face["image_uris"]
                break
    image_uris = {k: uris[k] for k in IMAGE_FIELDS if uris.get(k)}

    def num(v):
        try:
            f = float(v)
            return int(f) if f == int(f) else f
        except (TypeError, ValueError):
            return None

    return {
        "name": card.get("name"),
        "lang": card.get("lang", "en"),
        "mana_cost": card.get("mana_cost", ""),
        "cmc": card.get("cmc"),
        "type_line": card.get("type_line", ""),
        "colors": card.get("colors", []),
        "power": card.get("power"),
        "toughness": card.get("toughness"),
        "oracle_text": card.get("oracle_text", ""),
        "keywords": card.get("keywords", []),
        "legalities": {f: legalities.get(f) for f in
                       ("standard", "future", "historic", "gladiator", "pioneer",
                        "modern", "legacy", "pauper", "vintage", "commander", "oathbreaker",
                        "standard_brawl", "future_brawl", "classic_brawl", "brawl",
                        "timeless", "bullet", "predh", "premodern") if f in legalities},
        "prices": {k: num(prices.get(k)) for k in ("usd", "usd_foil", "usd_etched", "eur", "eur_foil", "tix")
                   if prices.get(k) is not None},
        "image_uris": image_uris,
        "scryfall_uri": card.get("scryfall_uri", ""),
    }

CSV_COLUMNS = ["name", "lang", "mana_cost", "cmc", "type_line", "colors",
               "power", "toughness", "oracle_text", "keywords",
               "usd", "usd_foil", "eur", "tix", "scryfall_uri"]

def _csv_row(card):
    s = slim_card(card)
    p = s["prices"]
    return [s["name"], s["lang"], s["mana_cost"], s["cmc"], s["type_line"],
            "|".join(s["colors"]) or "", s["power"] or "", s["toughness"] or "",
            (s["oracle_text"] or "").replace("\n", " "),
            "|".join(s["keywords"]),
            p.get("usd", ""), p.get("usd_foil", ""), p.get("eur", ""), p.get("tix", ""),
            s["scryfall_uri"]]

def emit_records(cards):
    """Write result cards to stdout in the active MODE (pretty handled elsewhere)."""
    import csv as _csv
    if MODE == "json":
        json.dump([slim_card(c_) for c_ in cards], sys.stdout, ensure_ascii=False, default=str)
        sys.stdout.write("\n")
    elif MODE == "jsonl":
        for c_ in cards:
            sys.stdout.write(json.dumps(slim_card(c_), ensure_ascii=False, default=str) + "\n")
    elif MODE in ("csv", "tsv"):
        writer = _csv.writer(sys.stdout, delimiter="," if MODE == "csv" else "\t",
                             lineterminator="\n")
        writer.writerow(CSV_COLUMNS)
        for c_ in cards:
            writer.writerow(_csv_row(c_))

def emit_single(payload):
    """Emit one structured object (used by fuzzy/image machine-mode paths)."""
    sys.stdout.write(json.dumps(payload, ensure_ascii=False, default=str) + "\n")

# ── Colour symbols for display ──────────────────────────────────────────
COLOUR_SYMBOLS = {
    "W": "⚪", "U": "🔵", "B": "⚫", "R": "🔴", "G": "🟢"
}
COLOUR_NAMES = {
    "W": "White", "U": "Blue", "B": "Black", "R": "Red", "G": "Green"
}

# ── Load all cards into memory ──────────────────────────────────────────
CARDS = []

def load_cards():
    global CARDS
    if CARDS:
        return
    if not os.path.exists(ORACLE_PATH):
        print(f"Error: Oracle cards file not found at {ORACLE_PATH}", file=sys.stderr)
        print("Run the Scryfall cache update first.", file=sys.stderr)
        sys.exit(1)
    with open(ORACLE_PATH, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line:
                try:
                    CARDS.append(json.loads(line))
                except json.JSONDecodeError:
                    continue

# ── Display a single card ───────────────────────────────────────────────
def display_card(card, index=None):
    name = card.get("name", "Unknown")
    mana = card.get("mana_cost", "—")
    cmc = card.get("cmc", "?")
    cmc_display = int(cmc) if isinstance(cmc, (int, float)) and cmc == int(cmc) else cmc
    type_line = card.get("type_line", "—")
    oracle = card.get("oracle_text", "—")
    power = card.get("power")
    toughness = card.get("toughness")
    colors = card.get("color_identity", [])
    keywords = card.get("keywords", [])
    legalities = card.get("legalities", {})

    # Colour display
    colour_str = " ".join(COLOUR_SYMBOLS.get(c, c) for c in colors) if colors else "—"

    # P/T display
    pt = f" ({power}/{toughness})" if power and toughness else ""

    # Format legality badges
    legal_formats = [f for f, v in legalities.items() if v == "legal" and f in ("commander", "modern", "legacy", "pauper", "vintage")]
    legal_str = ", ".join(legal_formats) if legal_formats else "none"

    # Build output
    prefix = f"  [{index}] " if index is not None else "  "
    print('\n' + prefix + c(name, '1;33') + '  ' + mana + '  (CMC ' + str(cmc_display) + ')')
    print(f"       {type_line}{pt}")
    print(f"       {colour_str}")
    if keywords:
        print(f"       Keywords: {', '.join(keywords)}")
    print(f"       {oracle}")
    print(f"       Legal: {legal_str}")
    print(f"       {card.get('scryfall_uri', '')}")

# ── Search functions ────────────────────────────────────────────────────
def search_name(query, exact=False):
    query_lower = query.lower().strip('"')
    results = []
    for card in CARDS:
        name = card.get("name", "").lower()
        if exact:
            if name == query_lower:
                results.append(card)
        else:
            if query_lower in name:
                results.append(card)
    return results

def search_text(query):
    query_lower = query.lower()
    results = []
    for card in CARDS:
        oracle = card.get("oracle_text", "").lower()
        if query_lower in oracle:
            results.append(card)
    return results

def search_type(query):
    query_lower = query.lower()
    results = []
    for card in CARDS:
        type_line = card.get("type_line", "").lower()
        if query_lower in type_line:
            results.append(card)
    return results

def search_color(colors):
    colors = set(colors.upper())
    results = []
    for card in CARDS:
        card_colors = set(card.get("color_identity", []))
        if colors.issubset(card_colors):
            results.append(card)
    return results

def search_cmc(expr):
    """Search by CMC. Supports: =3, <=3, >=3, or just a number."""
    expr = expr.strip()
    results = []

    if expr.startswith("<="):
        try:
            val = float(expr[2:])
            results = [c for c in CARDS if c.get("cmc", 99) <= val]
        except ValueError:
            pass
    elif expr.startswith(">="):
        try:
            val = float(expr[2:])
            results = [c for c in CARDS if c.get("cmc", 0) >= val]
        except ValueError:
            pass
    elif expr.startswith("="):
        try:
            val = float(expr[1:])
            results = [c for c in CARDS if c.get("cmc", -1) == val]
        except ValueError:
            pass
    else:
        try:
            val = float(expr)
            results = [c for c in CARDS if c.get("cmc", -1) == val]
        except ValueError:
            pass
    return results

def search_keyword(query):
    query_lower = query.lower()
    results = []
    for card in CARDS:
        keywords = [k.lower() for k in card.get("keywords", [])]
        if any(query_lower in k for k in keywords):
            results.append(card)
    return results

def search_general(query):
    """Search across name, oracle text, and type line."""
    query_lower = query.lower()
    results = []
    seen = set()
    for card in CARDS:
        card_id = card.get("id", "")
        if card_id in seen:
            continue
        name = card.get("name", "").lower()
        oracle = card.get("oracle_text", "").lower()
        type_line = card.get("type_line", "").lower()
        if query_lower in name or query_lower in oracle or query_lower in type_line:
            results.append(card)
            seen.add(card_id)
    return results

def search_random():
    return [rng.choice(CARDS)]

# ── Scryfall API calls for fuzzy matching ─────────────────────────────
SCRYFALL_API = "https://api.scryfall.com"
USER_AGENT = "scryfall-cli/1.0"

def _api_get(endpoint, params=None):
    """Make a GET request to the Scryfall API. Returns parsed JSON or None."""
    url = f"{SCRYFALL_API}{endpoint}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        # Return the error body so callers can inspect it
        body = None
        try:
            body = json.loads(e.read().decode("utf-8"))
        except Exception:
            pass
        return {"error": True, "status": e.code, "body": body}
    except Exception as e:
        return {"error": True, "status": 0, "body": {"details": str(e)}}

def scryfall_fuzzy(name):
    """Fuzzy card lookup via /cards/named?fuzzy=. Returns card dict or error dict."""
    return _api_get("/cards/named", {"fuzzy": name})

def scryfall_autocomplete(query):
    """Autocomplete card names via /cards/autocomplete. Returns list of names or empty list."""
    result = _api_get("/cards/autocomplete", {"q": query})
    if result and not result.get("error") and "data" in result:
        return result["data"]
    return []

def handle_fuzzy(query, options=None):
    """Fuzzy search: try fuzzy → if ambiguous/no match, autocomplete → pick → lookup.

    In machine mode (json/jsonl/csv/tsv) it is fully non-interactive: emits a
    single JSON object {query, match, candidates} instead of prompting with
    input(), which would hang an LLM harness forever.
    """
    if not query:
        print("\n  Usage: scryfall fuzzy <card name>")
        return

    # Step 1: Try Scryfall fuzzy match
    if not machine_mode():
        print('\n  ' + c('Searching for:', '1') + ' \"' + query + '\"')
    result = scryfall_fuzzy(query)

    matched_name = None
    if result and not result.get("error"):
        # Sanity check: is the returned name actually similar to the query?
        name = result.get("name", "Unknown")
        ratio = difflib.SequenceMatcher(None, query.lower(), name.lower()).ratio()
        query_words = set(w.lower() for w in query.split() if len(w) >= 3)
        name_lower = name.lower()
        has_word_overlap = any(w in name_lower or name_lower.startswith(w[:4]) for w in query_words)

        if ratio >= 0.55 or has_word_overlap:
            matched_name = name
        elif not machine_mode():
            # Fuzzy returned something unrelated — treat as no match
            print("  " + c(fmt("~ Scryfall suggested '{}' but it doesn't match your query.", name), '1;33') + "\n")

    # Step 2: Gather autocomplete suggestions (candidates)
    suggestions = []
    if matched_name is None:
        suggestions = scryfall_autocomplete(query)
        if not suggestions:
            words = [w for w in query.split() if len(w) >= 3]
            for word in words:
                suggestions = scryfall_autocomplete(word)
                if suggestions:
                    break

    # ── Machine mode: emit structured result, never prompt ──
    if machine_mode():
        card = None
        if matched_name:
            local = search_name(matched_name, exact=True)
            card = local[0] if local else (result if result and not result.get("error") else None)
        payload = {"query": query,
                   "match": slim_card(card) if card else None,
                   "candidates": suggestions[:10]}
        emit_single(payload)
        return

    if matched_name:
        print('  ' + c('✓ Found:', '1;32') + ' ' + matched_name + '\n')
        local = search_name(matched_name, exact=True)
        if local:
            display_card(local[0])
        else:
            display_api_card(result)
        return

    error_body = (result or {}).get("body", {}) or {}
    details = error_body.get("details", "")
    print('  ' + c('✗ No exact fuzzy match.', '1;31') + ' ' + details + '\n')

    if not suggestions:
        print("  No close matches found. Try a different spelling or use 'scryfall name' for partial search.")
        return

    # Step 3: Show suggestions and let user pick
    print("  {c('Did you mean…', '1;36')}")
    for i, name in enumerate(suggestions, 1):
        print(f"    [{i}] {name}")
    print(f"    [0] Cancel\n")

    try:
        choice = input("  Pick a number: ").strip()
        choice = int(choice)
    except (ValueError, EOFError):
        print("  Cancelled.")
        return

    if choice < 1 or choice > len(suggestions):
        print("  Cancelled.")
        return

    picked = suggestions[choice - 1]
    print('\n  ' + c('→ Looking up:', '1;32') + ' ' + picked + '\n')

    # Step 4: Lookup the picked card from local cache (exact)
    local = search_name(picked, exact=True)
    if local:
        display_card(local[0])
    else:
        # Fall back to API
        api_card = scryfall_fuzzy(picked)
        if api_card and not api_card.get("error"):
            display_api_card(api_card)
        else:
            print(f"  Could not find '{picked}' in cache or on Scryfall.")

def display_api_card(card):
    """Display a card from API JSON (same format as Oracle cache but may have extra fields)."""
    name = card.get("name", "Unknown")
    mana = card.get("mana_cost", "—")
    cmc = card.get("cmc", "?")
    cmc_display = int(cmc) if isinstance(cmc, (int, float)) and cmc == int(cmc) else cmc
    type_line = card.get("type_line", "—")
    oracle = card.get("oracle_text", "—")
    power = card.get("power")
    toughness = card.get("toughness")
    colors = card.get("color_identity", [])
    keywords = card.get("keywords", [])
    legalities = card.get("legalities", {})

    colour_str = " ".join(COLOUR_SYMBOLS.get(c, c) for c in colors) if colors else "—"
    pt = f" ({power}/{toughness})" if power and toughness else ""
    legal_formats = [f for f, v in legalities.items() if v == "legal" and f in ("commander", "modern", "legacy", "pauper", "vintage")]
    legal_str = ", ".join(legal_formats) if legal_formats else "none"

    print('\n  ' + c(name, '1;33') + '  ' + mana + '  (CMC ' + str(cmc_display) + ')')
    print(f"       {type_line}{pt}")
    print(f"       {colour_str}")
    if keywords:
        print(f"       Keywords: {', '.join(keywords)}")
    print(f"       {oracle}")
    print(f"       Legal: {legal_str}")
    print(f"       {card.get('scryfall_uri', '')}")

# ── Price display ─────────────────────────────────────────────────────
def format_price(value, symbol="$"):
    """Format a price string with currency symbol, or return '—' for None/null."""
    if value is None:
        return "—"
    try:
        amount = float(value)
        return f"{symbol}{amount:,.2f}"
    except (ValueError, TypeError):
        return "—"

def display_price_card(card, index=None):
    """Display a card with prices prominent."""
    name = card.get("name", "Unknown")
    mana = card.get("mana_cost", "—")
    type_line = card.get("type_line", "—")
    cmc = card.get("cmc", "?")
    cmc_display = int(cmc) if isinstance(cmc, (int, float)) and cmc == int(cmc) else cmc
    colors = card.get("color_identity", [])
    prices = card.get("prices", {})

    colour_str = " ".join(COLOUR_SYMBOLS.get(c, c) for c in colors) if colors else "—"

    usd = format_price(prices.get("usd"), "$")
    usd_foil = format_price(prices.get("usd_foil"), "$")
    eur = format_price(prices.get("eur"), "€")
    eur_foil = format_price(prices.get("eur_foil"), "€")
    tix = format_price(prices.get("tix"), "")

    prefix = f"  [{index}] " if index is not None else "  "
    print('\n' + prefix + c(name, '1;33') + '  ' + mana + '  (CMC ' + str(cmc_display) + ')')
    print(f"       {type_line}  •  {colour_str}")

    # Price line — only show foil if it has a value
    usd_part = f"USD {usd}"
    if usd_foil != "—":
        usd_part += f" (foil {usd_foil})"
    eur_part = f"EUR {eur}"
    if eur_foil != "—":
        eur_part += f" (foil {eur_foil})"
    tix_part = f"TIX {tix}"

    print('       ' + c(usd_part, '1;32') + '  •  ' + eur_part + '  •  ' + tix_part)
    print(f"       {card.get('scryfall_uri', '')}")

# ── Image download ──────────────────────────────────────────────────────
def _safe_filename(name):
    """Turn a card name into a safe filename (keep spaces, strip path chars)."""
    cleaned = re.sub(r'[<>:"/\\|?*\x00-\x1f]', "", name)
    return cleaned.strip() or "card"

def _pick_image(card, size="png", border=None):
    """Pick an image URI from a card dict. Returns (uri, ext) or (None, None)."""
    uris = card.get("image_uris") or {}
    # Some special cards (tokens, double-faced backs) store per-face URIs in
    # `card_faces`. Fall back to the first face that has images.
    if not uris and card.get("card_faces"):
        for face in card["card_faces"]:
            if face.get("image_uris"):
                uris = face["image_uris"]
                break

    if not uris:
        return None, None

    # Order of preference by requested size
    order = {
        "small": ["small", "normal", "large", "png"],
        "normal": ["normal", "large", "png", "small"],
        "large": ["large", "png", "normal", "small"],
        "png": ["png", "large", "normal", "small"],
    }.get(size, ["png", "large", "normal", "small"])

    uri = next((uris[k] for k in order if uris.get(k)), None)
    if not uri:
        return None, None

    # Determine extension from the URL itself (e.g. .png vs .jpg)
    path = urllib.parse.urlparse(uri).path.lower()
    ext = ".png" if path.endswith(".png") else (".jpg" if path.endswith(".jpg") else ".bin")
    return uri, ext

def _similarity(query, name):
    """Similarity score of query vs card name (0..1), with word-start bonus."""
    q, n = query.lower(), name.lower()
    ratio = difflib.SequenceMatcher(None, q, n).ratio()
    # Bonus if every query word lines up with a word in the name
    q_words = [w for w in re.split(r'\s+', q) if w]
    n_words = re.split(r'\s+', n)
    if q_words and all(any(nw.startswith(qw) or qw.startswith(nw) for nw in n_words) for qw in q_words):
        return max(ratio, 0.95)
    # Typo-tolerant: most query words found inside the name (e.g. "sol rng" → Sol Ring)
    contained = sum(1 for qw in q_words if len(qw) >= 2 and qw in n)
    if q_words and contained / len(q_words) >= 0.75:
        return max(ratio, 0.85)
    return ratio

def _normalize_name(name):
    """Lowercase, drop punctuation — used for closest-match comparison."""
    return re.sub(r"[\u2019'\".,!?|()/\\:-]", "", name.lower()).strip()

def _api_closest_match(card, query):
    """If the API returned an ambiguous result, pick the closest 'name' from its list."""
    candidates = card.get("name")
    if not isinstance(candidates, list) or not candidates:
        return None
    q_norm = _normalize_name(query)
    best = max(candidates, key=lambda c: _similarity(q_norm, _normalize_name(c)))
    return best if _similarity(q_norm, _normalize_name(best)) >= 0.6 else None

def _resolve_card(query):
    """Resolve a card name to (card, similarity). Shared by image + machine paths."""
    # Step 1: Scryfall fuzzy lookup (handles typos + gives us image URLs)
    api_card = scryfall_fuzzy(query)
    if api_card and api_card.get("error"):
        api_card = None
    if api_card and isinstance(api_card.get("name"), list):
        # Ambiguous match — API returned several candidate names; pick the best one
        chosen = _api_closest_match(api_card, query)
        api_card = scryfall_fuzzy(chosen) if chosen else None
        if api_card and api_card.get("error"):
            api_card = None
    # Guard against unrelated printed-name coincidences (e.g. fuzzy "sol rng"
    # returning a Portuguese card whose printed name starts with "Sol R")
    if api_card and not isinstance(api_card.get("name"), list):
        if _similarity(query, api_card.get("name", "")) < 0.55:
            api_card = None

    # Step 2: Local cache candidates (exact match wins outright)
    local_exact = search_name(query, exact=True)
    local_partial = [] if local_exact else search_name(query)

    # Step 3: Typo tolerance — match each query word against cached card names
    local_typo = []
    if not local_exact and not local_partial and len(query.split()) >= 2:
        q_words = [w.lower() for w in re.split(r'\s+', query) if len(w) >= 2]
        for card in CARDS:
            n_words = re.split(r'\s+', card.get("name", "").lower())
            hits = sum(1 for qw in q_words
                       if any(difflib.SequenceMatcher(None, qw, nw).ratio() >= 0.6 for nw in n_words))
            if hits == len(q_words):
                local_typo.append(card)

    card = None
    sim = 0.0
    if local_exact:
        card = local_exact[0]
        sim = 1.0
    elif api_card and not isinstance(api_card.get("name"), list):
        sim = _similarity(query, api_card.get("name", ""))
        card = api_card
    elif local_typo:
        best = max(local_typo, key=lambda c: _similarity(query, c.get("name", "")))
        card = best
        sim = _similarity(query, best.get("name", ""))

    # Step 4: Fall back to the best partial match from the local cache
    if card is None and local_partial:
        best = max(local_partial, key=lambda c: _similarity(query, c.get("name", "")))
        card = best
        sim = _similarity(query, best.get("name", ""))

    return card, sim

def handle_image(query, options):
    """Resolve a card name and download its image."""
    query = query.strip().strip('"')
    if not query:
        print("\n  Usage: scryfall image <card name> [--size small|normal|large|png] [--out <dir>] [--border black|silver]\n")
        return

    size = options.get("size", "png")
    out_dir = os.path.expanduser(options.get("out") or "~/Desktop")
    border = options.get("border")

    card, sim = _resolve_card(query)

    if card is None:
        if machine_mode():
            emit_single({"query": query, "saved": None, "error": "not_found"})
        else:
            print("\n  " + c(fmt("✗ Could not find a card matching '{}'.", query), '1;31') + "\n")
        return

    name = card.get("name", "Unknown")
    if not machine_mode():
        note = "" if sim >= 0.9 else "  " + c(fmt("(from '{}')", query), '2')
        print('\n  ' + c('Card:', '1') + ' ' + name + note)

    # If a border is requested, ask the API for that specific version
    if border:
        set_code = (card.get("set") or "").upper()
        api_card = _api_get("/cards/named", {"exact": name, "set": set_code}) if set_code else None
        if api_card and not api_card.get("error") and api_card.get("border") == border:
            card = api_card
        else:
            warn(f"no {border}-border version found; using default")

    uri, ext = _pick_image(card, size=size)
    if not uri:
        if machine_mode():
            emit_single({"query": query, "name": name, "saved": None, "error": "no_image"})
        else:
            print('  ' + c('✗ No image available for this card.', '1;31') + '\n')
        return

    # Build output path — avoid clobbering existing files
    os.makedirs(out_dir, exist_ok=True)
    base = _safe_filename(name)
    out_path = os.path.join(out_dir, f"{base}{ext}")
    counter = 1
    while os.path.exists(out_path):
        out_path = os.path.join(out_dir, f"{base} ({counter}){ext}")
        counter += 1

    if not machine_mode():
        print('  ' + c('Source:', '2') + ' ' + uri)
    try:
        req = urllib.request.Request(uri, headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=60) as resp, open(out_path, "wb") as f:
            shutil.copyfileobj(resp, f)
    except Exception as e:
        if machine_mode():
            emit_single({"query": query, "name": name, "source_uri": uri,
                         "saved": None, "error": f"download_failed: {e}"})
        else:
            print('  ' + c('✗ Download failed: ' + str(e), '1;31') + '\n')
        return

    if machine_mode():
        emit_single({"query": query, "name": name, "source_uri": uri,
                     "saved": out_path, "bytes": os.path.getsize(out_path), "error": None})
    else:
        size_kb = os.path.getsize(out_path) / 1024
        print('  ' + c('✓ Saved:', '1;32') + ' ' + out_path + '  (' + c(str(round(size_kb)) + ' KB', '2') + ')\n')

# ── Apply filters ───────────────────────────────────────────────────────
def apply_filters(results, commander=None, legal=None):
    if commander:
        allowed = set(commander.upper())
        results = [c for c in results if set(c.get("color_identity", [])).issubset(allowed)]
    if legal:
        legal = legal.lower()
        results = [c for c in results if c.get("legalities", {}).get(legal) == "legal"]
    return results

# ── Parse arguments ─────────────────────────────────────────────────────
def parse_args(args):
    """Parse command line arguments into (command, query, options)."""
    command = None
    query_parts = []
    options = {"limit": 10, "commander": None, "legal": None, "exact": False, "sort": None,
               "size": None, "out": None, "border": None, "format": None}

    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--limit" and i + 1 < len(args):
            try:
                options["limit"] = int(args[i + 1])
            except ValueError:
                pass
            i += 2
        elif arg == "--commander" and i + 1 < len(args):
            options["commander"] = args[i + 1]
            i += 2
        elif arg == "--legal" and i + 1 < len(args):
            options["legal"] = args[i + 1]
            i += 2
        elif arg == "--exact":
            options["exact"] = True
            i += 1
        elif arg == "--sort" and i + 1 < len(args):
            options["sort"] = args[i + 1].lower()
            i += 2
        elif arg == "--size" and i + 1 < len(args):
            options["size"] = args[i + 1].lower()
            i += 2
        elif arg == "--out" and i + 1 < len(args):
            options["out"] = args[i + 1]
            i += 2
        elif arg == "--border" and i + 1 < len(args):
            options["border"] = args[i + 1].lower()
            i += 2
        elif arg == "--format" and i + 1 < len(args):
            options["format"] = args[i + 1].lower()
            i += 2
        elif arg in ("--json", "-j"):
            options["format"] = "json"
            i += 1
        elif arg == "--jsonl":
            options["format"] = "jsonl"
            i += 1
        elif arg == "--csv":
            options["format"] = "csv"
            i += 1
        elif arg == "--tsv":
            options["format"] = "tsv"
            i += 1
        elif arg == "--pretty":
            options["format"] = "pretty"
            i += 1
        elif command is None:
            command = arg.lower()
            i += 1
        else:
            query_parts.append(arg)
            i += 1

    query = " ".join(query_parts) if query_parts else ""
    return command, query, options

# ── Update cache ─────────────────────────────────────────────────────
def handle_update():
    """Download the latest Oracle Cards bulk data from Scryfall."""
    cache_dir = os.path.dirname(ORACLE_PATH)
    os.makedirs(cache_dir, exist_ok=True)

    gz_path = ORACLE_PATH + ".gz"
    backup_path = ORACLE_PATH + ".backup"

    # 1. Get the download URL
    print("\n  Fetching Scryfall bulk-data catalogue...")
    try:
        req = urllib.request.Request(
            "https://api.scryfall.com/bulk-data",
            headers={"User-Agent": "scryfall-cli/1.0", "Accept": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            bulk_data = json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(c('  ✗ Failed to fetch catalogue: ' + str(e), '1;31'))
        sys.exit(1)

    download_url = None
    for item in bulk_data.get("data", []):
        if item.get("type") == "oracle_cards":
            download_url = item.get("jsonl_download_uri")
            break

    if not download_url:
        print("{c('  ✗ Could not find oracle_cards download URL.', '1;31')}")
        sys.exit(1)

    # 2. Download the gzipped file
    print(f"  Downloading from:\n  {download_url}")
    try:
        req = urllib.request.Request(
            download_url,
            headers={"User-Agent": "scryfall-cli/1.0"},
        )
        with urllib.request.urlopen(req, timeout=300) as resp:
            with open(gz_path, "wb") as f:
                shutil.copyfileobj(resp, f)
    except Exception as e:
        print(c('  ✗ Download failed: ' + str(e), '1;31'))
        sys.exit(1)

    if os.path.getsize(gz_path) == 0:
        os.remove(gz_path)
        print("{c('  ✗ Downloaded file is empty.', '1;31')}")
        sys.exit(1)

    # 3. Decompress and replace
    print("  Decompressing...")
    try:
        # Back up existing cache
        if os.path.exists(ORACLE_PATH):
            shutil.copy2(ORACLE_PATH, backup_path)

        with gzip.open(gz_path, "rb") as f_in:
            with open(ORACLE_PATH, "wb") as f_out:
                shutil.copyfileobj(f_in, f_out)

        os.remove(gz_path)
    except Exception as e:
        # Restore backup on failure
        if os.path.exists(backup_path):
            shutil.move(backup_path, ORACLE_PATH)
        if os.path.exists(gz_path):
            os.remove(gz_path)
        print(c('  ✗ Decompression failed: ' + str(e), '1;31'))
        sys.exit(1)

    # 4. Count and report
    line_count = 0
    with open(ORACLE_PATH, "r", encoding="utf-8") as f:
        for line in f:
            if line.strip():
                line_count += 1

    file_size = os.path.getsize(ORACLE_PATH)
    size_mb = file_size / (1024 * 1024)
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")

    # Clean up backup
    if os.path.exists(backup_path):
        os.remove(backup_path)

    print('\n  ' + c('✓ Oracle cache updated: ' + timestamp, '1;32'))
    print(f"    File:  {ORACLE_PATH}")
    print(f"    Size:  {size_mb:.1f} MB")
    print(f"    Cards: {line_count:,}\n")

VALID_COMMANDS = {"name", "text", "type", "color", "cmc", "keyword", "fuzzy", "random", "search", "price", "image", "update"}

def sort_results(results, sort_key):
    """Sort results by the given key."""
    if sort_key == "name":
        return sorted(results, key=lambda c: c.get("name", "").lower())
    elif sort_key == "cmc":
        return sorted(results, key=lambda c: c.get("cmc", 0))
    elif sort_key == "price":
        def usd_val(c):
            p = c.get("prices", {}).get("usd")
            return float(p) if p else 0
        return sorted(results, key=usd_val, reverse=True)
    else:
        print("\n  " + c(fmt("⚠ Unknown sort field '{}'. Use 'name', 'cmc', or 'price'.", sort_key), '1;33'))
        return results

# ── Main ────────────────────────────────────────────────────────────────
def main():
    global MODE, USE_COLOR

    if len(sys.argv) < 2:
        print(__doc__)
        return

    command, query, options = parse_args(sys.argv[1:])

    # Resolve output format: flag > $SCRYFALL_FORMAT > TTY auto-detect
    MODE = resolve_format(options.get("format"))
    USE_COLOR = _colors_enabled(MODE)

    # Handle update command (doesn't need card data)
    if command == "update":
        handle_update()
        return

    # Handle image command (uses API first, local cache as fallback)
    if command == "image":
        load_cards()
        handle_image(query, options)
        return

    # Validate command (#4)
    if command and command not in VALID_COMMANDS:
        if machine_mode():
            emit_single({"error": "unknown_command", "command": command,
                         "valid_commands": sorted(VALID_COMMANDS - {"update"})})
        else:
            print("\n  " + c(fmt("✗ Unknown command '{}'.", command), '1;31'))
            print(f"  Valid commands: {', '.join(sorted(VALID_COMMANDS - {'update'}))}")
            print(f"  Use 'scryfall search \"{command} {query}\"' for a general search.\n")
        sys.exit(1)

    # Guard empty queries (#1) — except random which needs no query
    if command != "random" and not query.strip():
        if machine_mode():
            emit_single({"error": "empty_query", "command": command})
        else:
            print('\n  ' + c('✗ No search query provided.', '1;31'))
            print(f"  Usage: scryfall {command} <query>\n")
        sys.exit(1)

    # Load cards
    load_cards()

    # Run search
    results = []
    if command == "name":
        results = search_name(query, exact=options["exact"])
    elif command == "fuzzy":
        handle_fuzzy(query, options)
        return
    elif command == "text":
        results = search_text(query)
    elif command == "type":
        results = search_type(query)
    elif command == "color":
        results = search_color(query)
    elif command == "cmc":
        results = search_cmc(query)
    elif command == "keyword":
        results = search_keyword(query)
    elif command == "random":
        results = search_random()
    elif command == "search":
        results = search_general(query)
    elif command == "price":
        results = search_name(query, exact=options["exact"])
        # Default to price-sorted (most expensive first) when no sort specified
        if not options["sort"]:
            options["sort"] = "price"

    # Apply filters
    results = apply_filters(results, commander=options["commander"], legal=options["legal"])

    # Apply sort (#5)
    if options["sort"]:
        results = sort_results(results, options["sort"])

    limit = options["limit"]
    total = len(results)
    shown = min(limit, total)

    # ── Machine-readable output: stdout is pure data, meta goes to stderr ──
    if machine_mode():
        if total > shown:
            warn(f"{shown} of {total} matches shown (use --limit {total} for all)")
        emit_records(results[:shown])
        return

    # Display
    if not results:
        print(f"\n  No cards found matching your search.")
        return

    if total > shown:
        print(f"\n  Showing {shown} of {total} results (use --limit {total} to see all):")
    else:
        print(f"\n  Found {total} result{'s' if total != 1 else ''}:")

    display_fn = display_price_card if command == "price" else display_card
    for i, card in enumerate(results[:shown], 1):
        display_fn(card, index=i)

    print()  # trailing newline

if __name__ == "__main__":
    main()
